{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "atlas-services/hermes-booking-bundle": "dev-main",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6",
        "liip/imagine-bundle": "^2.17",
        "stof/doctrine-extensions-bundle": "^1.15",
        "symfony/asset": "8.0.*",
        "symfony/asset-mapper": "8.0.*",
        "symfony/console": "8.0.*",
        "symfony/dotenv": "8.0.*",
        "symfony/expression-language": "8.0.*",
        "symfony/flex": "^2",
        "symfony/form": "8.0.*",
        "symfony/framework-bundle": "8.0.*",
        "symfony/http-client": "8.0.*",
        "symfony/mailer": "8.0.*",
        "symfony/monolog-bundle": "^4.0",
        "symfony/rate-limiter": "8.0.*",
        "symfony/routing": "8.0.*",
        "symfony/runtime": "8.0.*",
        "symfony/security-bundle": "8.0.*",
        "symfony/stimulus-bundle": "^2.34",
        "symfony/translation": "8.0.*",
        "symfony/twig-bundle": "8.0.*",
        "symfony/ux-autocomplete": "^2.34",
        "symfony/ux-icons": "^2.34",
        "symfony/ux-twig-component": "^2.34",
        "symfony/validator": "8.0.*",
        "symfony/yaml": "8.0.*",
        "twig/extra-bundle": "^2.12|^3.0",
        "twig/inky-extra": "^3.24",
        "twig/intl-extra": "^3.24",
        "twig/string-extra": "^3.24",
        "twig/twig": "^2.12|^3.0",
        "vich/uploader-bundle": "^2.9"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../hermesBookingBundle",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/atlas-services/HermesBookingBundle"
        }
    ],
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "prepare-var-dirs": [
            "@php -r \"foreach (['var/cache', 'var/log', 'var/sessions'] as \\$d) { if (!is_dir(\\$d)) { mkdir(\\$d, 0777, true); } }\""
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd",
            "asset-map:compile": "symfony-cmd"
        },
        "create-db-file": [
            "@php -r \"require 'vendor/autoload.php'; (new Symfony\\Component\\Dotenv\\Dotenv())->bootEnv(getcwd() . '/.env'); \\$db = \\$_ENV['APP_DB'] ?? getenv('APP_DB'); if (!\\$db) { fwrite(STDERR, 'APP_DB is not set\\n'); exit(1); } \\$path = 'data/db/' . \\$db; if (!is_dir('data/db')) mkdir('data/db', 0777, true); if (!file_exists(\\$path)) touch(\\$path);\""
        ],
        "create-upload-dir": [
            "@php -r \"require 'vendor/autoload.php'; (new Symfony\\Component\\Dotenv\\Dotenv())->bootEnv(getcwd() . '/.env'); \\$base = \\$_ENV['APP_BASE_MEDIA_DATA'] ?? getenv('APP_BASE_MEDIA_DATA'); if (!\\$base) { fwrite(STDERR, 'APP_BASE_MEDIA_DATA is not set\\n'); exit(1); } \\$path = 'public/' . trim(\\$base, '/'); if (!is_dir(\\$path)) { mkdir(\\$path, 0777, true); }\""
        ],
        "deploy-assets": [
            "@php bin/console importmap:install",
            "@php bin/console asset-map:compile"
        ],
        "post-install-cmd": [
            "@prepare-var-dirs",
            "@create-upload-dir",
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@prepare-var-dirs",
            "@create-upload-dir",
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.0.*",
            "docker": true
        }
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.0",
        "squizlabs/php_codesniffer": "^4.0",
        "symfony/browser-kit": "8.0.*",
        "symfony/css-selector": "8.0.*",
        "symfony/debug-bundle": "8.0.*",
        "symfony/maker-bundle": "^1.67",
        "symfony/stopwatch": "8.0.*",
        "symfony/web-profiler-bundle": "8.0.*"
    }
}
