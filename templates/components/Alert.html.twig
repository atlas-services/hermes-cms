
{% for type, messages in app.flashes %}
    {% for message in messages %}
        {% set alertType = type starts with 'newsletter_' ? type|replace({'newsletter_': ''}) : type %}
        <div class="alert alert-{{ alertType }} {{ class|default('') }} alert-dismissible fade show" role="alert" style="position: relative; z-index: 10;">
            {% if type starts with 'newsletter_' %}
                {{ message|raw }}
            {% else %}
                {{ message|trans({}, 'messages') }}
            {% endif %}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
{% endfor %}
