{% extends 'security/base.html.twig' %}

{% block title %}{{ 'security.reset_password.title'|trans }}{% endblock %}

{% block content %}
<section id="container" class="my-5 py-5">
    <div class="container-fluid col-lg-4 my-5 py-5 shadow-sm border border-secondary rounded-3">
        {% include 'components/Alert.html.twig' %}
        <h1 class="h3 mb-4 text-center">{{ 'security.reset_password.heading'|trans }}</h1>

        {{ form_start(form) }}
            {{ form_row(form.plainPassword.first) }}
            {{ form_row(form.plainPassword.second) }}
            <button class="btn btn-outline-success w-100 mt-4" type="submit">
                {{ 'security.reset_password.submit'|trans }}
            </button>
        {{ form_end(form) }}

        <p class="mt-4 mb-0 text-center">
            <a class="text-decoration-none" href="{{ path('app_login', {'_locale': app.request.locale}) }}">
                {{ 'security.reset_password.back_to_login'|trans }}
            </a>
        </p>
    </div>
</section>
{% endblock %}
