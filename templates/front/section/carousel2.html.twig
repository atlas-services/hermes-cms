{# Porté depuis atlas-services/hermes release/2.2.7 (templates/front/base/hermes/template/carousel2.html.twig) — chemins & configs Hermes3. #}
<!-- Section carousel -->
<section id="{{ section.id }}" class="pb-0  px-0">
    <div class="container col-12 col-lg-{{ (section.templateWidth ?? configs.carousel_container_width|default(8))|col_lg  }}" >
            <!--Carousel Wrapper-->
            <div id="carousel-fade" class="carousel slide carousel-fade" data-bs-ride="carousel">
                <!--Indicators-->
                <div class="carousel-indicators">
                    {% for key, post in posts|sort((a, b) => a.position <=> b.position) %}
                        {% set active = '' %}
                        {% if 0 == key %}
                            {% set active = 'active' %}
                        {% endif %}
                        <li data-bs-target="#carousel-fade" data-bs-slide-to="{{ key }}" class="{{ active }}"></li>
                    {% endfor %}
                </ol>
                <!--/.Indicators-->
                <!--Slides-->
                <div class="carousel-inner" role="listbox">
                    {% for key, post in posts|sort((a, b) => a.position <=> b.position) %}
                        {% set active = '' %}
                        {% if 0 == key %}
                            {% set active = 'active' %}
                        {% endif %}
                        <div class="carousel-item  col-12 px-0 {{ active }}">
                            {% if(vich_uploader_asset(post, 'imageFile') is not null) %}
                            <img class="d-block w-100 " src="{{ asset(vich_uploader_asset(post, 'imageFile')) }}"
                                 alt="{{ post.name }}">
                            {% endif %}
                            <div class="carousel-caption">
                                <h5>
                                {% if( not section.template2) %}
                                    {{ post.name }}
                                {% else %}
                                    {% if section.template2 and section.template2.code in ['modale1', 'modale3' ] %}
                                        <!-- Modale1  -->
                                         <a style="color:{{ configs.content_link_color|default('#000000') }}" onmouseover="this.style.color='{{ configs.content_link_hover_color|default('#ffffff') }}'" onmouseout="this.style.color='{{ configs.content_link_color|default('#000000') }}'" class="thumbnail portfolio-link" href="#" data-image-id="" data-name="{{ post.name }}" data-content="{{ post.content }}"  data-bs-toggle="modal"
                                           data-image ="{{ asset(vich_uploader_asset(post, 'imageFile')) }}"
                                           data-bs-target="#image-gallery-{{ section.id }}">
                                            {{ post.name }}
                                        </a>
                                    {% endif %}
                                    {% if section.template2 and 'modale2' == section.template2.code %}
                                    <!-- Modale2  -->
                                     <a style="color:{{ configs.content_link_color|default('#000000') }}" onmouseover="this.style.color='{{ configs.content_link_hover_color|default('#ffffff') }}'" onmouseout="this.style.color='{{ configs.content_link_color|default('#000000') }}'" class="portfolio-link" data-bs-toggle="modal" href="#portfolioModal{{ post.id }}">
                                        {{ post.name }}
                                    </a>
                                    {% endif %}
                                    {% endif %}
                                </h5>
                            </div>
                        </div>
                    {% endfor %}
                </div>
                <!--/.Slides-->
                <!--Controls-->
                 <a style="color:{{ configs.content_link_color|default('#000000') }}" onmouseover="this.style.color='{{ configs.content_link_hover_color|default('#ffffff') }}'" onmouseout="this.style.color='{{ configs.content_link_color|default('#000000') }}'" class="carousel-control-prev" href="#carousel-fade" role="button" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </a>
                 <a style="color:{{ configs.content_link_color|default('#000000') }}" onmouseover="this.style.color='{{ configs.content_link_hover_color|default('#ffffff') }}'" onmouseout="this.style.color='{{ configs.content_link_color|default('#000000') }}'" class="carousel-control-next" href="#carousel-fade" role="button" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </a>
                <!--/.Controls-->
            </div>
            <!--/.Carousel Wrapper-->
        </div>
</section>


<!-- Modale 2 -->
{% include 'front/hermes/modale.html.twig' %}
