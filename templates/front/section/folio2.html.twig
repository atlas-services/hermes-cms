{# Porté depuis atlas-services/hermes release/2.2.7 (templates/front/base/hermes/template/folio2.html.twig) — chemins & configs Hermes3. #}
<!-- Portfolio Grid -->
<section id="{{ section.id }}" class="pb-0  px-0" style="background-color:{{ section.templateBgcolor ?? configs.content_bgcolor|default('#ffffff') }}">
    <div class="container-fluid col-12 col-lg-{{ (section.templateWidth ?? configs.folio_container_width|default(8))|col_lg }}" >
            <div class="row">
                <div class="col-lg-12 col-12 text-center">
                </div>
            </div>
            <div id="folio" class="row">
                {% for post in  posts|sort((a, b) => a.position <=> b.position) %}
                    <div class="col-md-{{ section.templateNbCol|nb_col }} col-lg-{{ section.templateNbCol|nb_col }} portfolio-item text-center ">
                        {% if( not section.template2) %}
                            <img class="img-fluid col-12 col-sm-8 " src="{{ asset(vich_uploader_asset(post, 'imageFile')) }}"
                                 alt="{{ post.name }}">
                        {% else %}
                            {% if section.template2 and section.template2.code in ['modale1', 'modale3' ] %}
                                <!-- Modale1  -->
                                 <a class="d-block mb-4 thumbnail portfolio-link" href="#" data-image-id="" data-name="{{ post.name }}" data-content="{{ post.content }}"  data-bs-toggle="modal"
                                   data-image ="{{ asset(vich_uploader_asset(post, 'imageFile')) }}"
                                   data-bs-target="#image-gallery-{{ section.id }}">
                                    <div style="background-color:{{ configs.content_link_color|default('#000000') }}; " onmouseover="this.style.opacity='0.6'" onmouseout="this.style.opacity='0'"
                                         class="portfolio-hover">
                                        <div class="portfolio-hover-content">
                                            <i class="fa fa-plus fa-3x"></i>
                                        </div>
                                    </div>
                                    {% if(vich_uploader_asset(post, 'imageFile') is not null) %}
                                        <img class="img-fluid col-12 col-sm-8 " src="{{ asset(vich_uploader_asset(post, 'imageFile')) }}"
                                             alt="{{ post.name }}">
                                    {% endif %}
                                </a>
                            {% endif %}
                            {% if section.template2 and 'modale2' == section.template2.code %}
                                <!-- Modale2  -->
                                 <a class="portfolio-link" data-bs-toggle="modal" href="#portfolioModal{{ post.id }}">
                                    <div style="background-color:{{ configs.content_link_color|default('#000000') }}; " onmouseover="this.style.opacity='0.6'" onmouseout="this.style.opacity='0'"
                                         class="portfolio-hover">
                                        <div class="portfolio-hover-content">
                                            <i class="fa fa-plus fa-3x"></i>
                                        </div>
                                    </div>
                                    {% if(vich_uploader_asset(post, 'imageFile') is not null) %}
                                        <img class="img-fluid " src="{{ asset(vich_uploader_asset(post, 'imageFile')) }}"
                                             alt="{{ post.name }}">
                                    {% endif %}
                                </a>
                            {% endif %}
                        {% endif %}

                    </div>
                {% endfor %}
            </div>
    </div>
</section>

<!-- Modale -->
{% include 'front/hermes/modale.html.twig' %}
