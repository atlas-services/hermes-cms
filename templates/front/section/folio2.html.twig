{# Folio Dynamique — grille images avec apparition GSAP configurable (section.templateGsapImageEffect). #}
{% set folioWidth = (section.templateWidth ?? configs.folio_container_width|default(8))|col_lg %}
{% set colClass = section.templateNbCol|nb_col %}
{% set sortedPosts = posts|sort((a, b) => a.position <=> b.position) %}
{% set rawGsap = section.templateGsapImageEffect %}
{% set gsapEnabled = rawGsap != 'aucun' %}
{% set gsapEffectValue = (rawGsap is not null and rawGsap != '' and rawGsap != 'aucun') ? rawGsap : 'horizontal-right' %}

<section id="{{ section.id }}" class="pb-0 mx-auto px-0" style="background-color:{{ section.templateBgcolor ?? configs.content_bgcolor|default('#ffffff') }}">
    <div class="container-fluid col-12 col-lg-{{ folioWidth }} mx-auto px-0">
        <div class="row g-3 g-md-4 px-2{{ gsapEnabled ? ' gsap-image-reveal' : '' }}"{% if gsapEnabled %} data-gsap-image-reveal-effect-value="{{ gsapEffectValue }}"{% endif %}>
            {% for post in sortedPosts %}
                {% if vich_uploader_asset(post, 'imageFile') is not null %}
                    {% set imageUrl = asset(vich_uploader_asset(post, 'imageFile')) %}
                    <div class="col-12 col-sm-{{ colClass }} col-md-{{ colClass }} col-lg-{{ colClass }}">
                        <figure class="{{ gsapEnabled ? 'gsap-image-reveal__item ' : '' }}ratio ratio-4x3 rounded-3 overflow-hidden shadow-sm mb-0">
                            {% if section.template2 and section.template2.code in ['modale1', 'modale3'] %}
                                <a
                                    class="d-block h-100 portfolio-link"
                                    href="#"
                                    data-image-id=""
                                    data-name="{{ post.name }}"
                                    data-content="{{ post.content }}"
                                    data-bs-toggle="modal"
                                    data-image="{{ imageUrl }}"
                                    data-bs-target="#image-gallery-{{ section.id }}"
                                    aria-label="{{ post.name }}"
                                >
                                    <img src="{{ imageUrl }}" alt="{{ post.name }}" width="800" height="600" loading="lazy">
                                </a>
                            {% elseif section.template2 and section.template2.code == 'modale2' %}
                                <a
                                    class="d-block h-100 portfolio-link"
                                    data-bs-toggle="modal"
                                    href="#portfolioModal{{ post.id }}"
                                    aria-label="{{ post.name }}"
                                >
                                    <img src="{{ imageUrl }}" alt="{{ post.name }}" width="800" height="600" loading="lazy">
                                </a>
                            {% else %}
                                <img src="{{ imageUrl }}" alt="{{ post.name }}" width="800" height="600" loading="lazy">
                            {% endif %}
                        </figure>
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</section>

{% include 'front/hermes/modale.html.twig' %}
