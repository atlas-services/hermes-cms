{# Porté depuis Hermes 2.2.7 — carrousel section posts ; Splide focus (templateNbCol desktop / plein écran mobile). #}
{% set accentColor = configs.content_link_color|default('#0d6efd') %}
{% set imagesPerRow = section.templateNbCol %}
{% set sortedPosts = posts|sort((a, b) => a.position <=> b.position) %}

<section id="{{ section.id }}" class="pb-0 px-0">
    <div class="container-fluid col-12 mx-auto px-0" style="background-color:{{ section.templateBgcolor ?? configs.content_bgcolor|default('#ffffff') }}">
        <div class="row g-0 justify-content-center">
            <div class="col-12 px-0 position-relative">
                <div
                    class="splide splide-carousel splide-carousel--natural w-100 position-relative overflow-hidden"
                    style="--splide-carousel-accent: {{ accentColor }};"
                    data-splide-carousel-effect-value="focus"
                    data-splide-carousel-per-page-value="{{ imagesPerRow }}"
                    data-splide-carousel-per-page-mobile-value="1"
                    data-splide-carousel-breakpoint-value="992"
                    data-splide-carousel-gap-value="1rem"
                    data-splide-carousel-gap-mobile-value="0"
                    data-splide-carousel-autoplay-value="true"
                    data-splide-carousel-interval-value="4200"
                    data-splide-carousel-speed-value="750"
                    role="region"
                    aria-label="{{ section.name|default('Carousel') }}"
                >
                    <div class="splide__track">
                        <ul class="splide__list">
                            {% for post in sortedPosts %}
                                {% if vich_uploader_asset(post, 'imageFile') is not null %}
                                    <li class="splide__slide position-relative">
                                        {% set imageUrl = asset(vich_uploader_asset(post, 'imageFile')) %}
                                        {% if section.template2 and section.template2.code in ['modale1', 'modale3'] %}
                                            <a
                                                class="d-block w-100 thumbnail portfolio-link"
                                                href="#"
                                                data-image-id=""
                                                data-name="{{ post.name }}"
                                                data-content="{{ post.content }}"
                                                data-bs-toggle="modal"
                                                data-image="{{ imageUrl }}"
                                                data-bs-target="#image-gallery-{{ section.id }}"
                                                aria-label="{{ post.name }}"
                                            >
                                                <img class="img-fluid w-100" src="{{ imageUrl }}" alt="{{ post.name }}" loading="lazy">
                                            </a>
                                        {% elseif section.template2 and section.template2.code == 'modale2' %}
                                            <a
                                                class="d-block w-100 portfolio-link"
                                                data-bs-toggle="modal"
                                                href="#portfolioModal{{ post.id }}"
                                                aria-label="{{ post.name }}"
                                            >
                                                <img class="img-fluid w-100" src="{{ imageUrl }}" alt="{{ post.name }}" loading="lazy">
                                            </a>
                                        {% else %}
                                            <img class="img-fluid w-100" src="{{ imageUrl }}" alt="{{ post.name }}" loading="lazy">
                                        {% endif %}
                                    </li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{% include 'front/hermes/modale.html.twig' %}
