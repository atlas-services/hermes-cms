{# Porté depuis atlas-services/hermes release/2.2.7 (templates/front/base/hermes/template/card1.html.twig) — chemins & configs Hermes3. #}
<!-- Portfolio Grid -->
<section id="{{ section.id }}" class="pb-0 pb-lg-4  mx-auto px-0" style="background-color:{{ section.templateBgcolor ?? configs.content_bgcolor|default('#ffffff') }}">
    <div class="container-fluid col-12 col-lg-{{ (section.templateWidth ?? configs.folio_container_width|default(8))|col_lg }} mx-auto px-0" >

        <div id="folio"  class="row ">
            {% for post in  posts|sort((a, b) => a.position <=> b.position) %}
                {% if(vich_uploader_asset(post, 'imageFile') is not null) %}
                    <div class="col-lg-{{ section.templateNbCol|nb_col }} col-md-{{ section.templateNbCol|nb_col }} col-12 text-center mb-2 mb-md-4" >
                        <div class="col-lg-12 col-md-12 col-12 text-center">
                            <div class="col-lg-5 col-12 h-rounded-lg-1 pt-5 pl-5 pr-5 pb-2  my-3 w-auto shadow-lg text-center" style="background-color: {{ configs.card_bgcolor|default('#f8f9fa') }};color: {{ configs.card_color|default('#212529') }};">
                                <p class="h3"> {{ post }}</p>
                                <div class="text-left pb-5">
                                    {{ post.content|striptags|u.truncate(600, '...')|raw }}
                                </div>
                                {% if vich_uploader_asset(post, 'imageFile') is not null %}
                                    {#                    <div class="col-lg-10 col-12 text-center mx-auto h-position-absolute h-bottom-10 " >#}
                                    <div class="col-lg-12 col-12 text-center mx-auto " >
                                        <a style="color:{{ configs.content_link_color|default('#000000') }}" onmouseover="this.style.color='{{ configs.content_link_hover_color|default('#ffffff') }}'" onmouseout="this.style.color='{{ configs.content_link_color|default('#000000') }}'"
                                           class="col-lg-2 col-12 btn btn-outline-danger h-rounded-lg-4 pt-2 pb-2 "
                                           href="{{ asset(vich_uploader_asset(post, 'imageFile')) }}"
                                           rel="noopener noreferrer" target="_blank">Télécharger</a>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</section>

<!-- Modale -->
{% include 'front/hermes/modale.html.twig' %}
