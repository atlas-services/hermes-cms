{# Porté depuis atlas-services/hermes release/2.2.7 (templates/front/base/hermes/template/folio4.html.twig) — chemins & configs Hermes3. #}
<!-- Portfolio Grid -->

<section id="{{ section.id }}" class="pb-0  mx-auto" style="background-color:{{ section.templateBgcolor ?? configs.content_bgcolor|default('#ffffff') }}">
    <div class="container-fluid col-12 col-lg-{{ (section.templateWidth ?? configs.folio_container_width|default(8))|col_lg }}">
        <div class="row mx-auto pb-2 pb-lg-5" id="folio">
                    <div id="staggering" class="{{ configs.staggering_px|default('') }} px-2">
                    {% for post in  posts|sort((a, b) => a.position <=> b.position) %}
                    <div class="col-md-{{ section.templateNbCol|nb_col }} col-sm-{{ section.templateNbCol|nb_col }} col-12" >
                        {% if(vich_uploader_asset(post, 'imageFile') is not null) %}
                            {% if( not section.template2) %}
                                <span class="staggering">
                                    <img class="stagge"   src="{{ asset(vich_uploader_asset(post, 'imageFile'))}}"/>
                                </span>
                            {% else %}
                                {% if section.template2 and section.template2.code in ['modale1', 'modale3' ] %}
                                    <!-- Modale1  -->
                                     <a style="color:{{ configs.content_link_color|default('#000000') }}" onmouseover="this.style.color='{{ configs.content_link_hover_color|default('#ffffff') }}'" onmouseout="this.style.color='{{ configs.content_link_color|default('#000000') }}'" class="thumbnail portfolio-link" href="#" data-image-id="" data-name="{{ post.name }}" data-content="{{ post.content }}"  data-bs-toggle="modal"
                                       data-image ="{{ asset(vich_uploader_asset(post, 'imageFile')) }}"
                                       data-bs-target="#image-gallery-{{ section.id }}">
                                        <span class="staggering">
                                            <img class="stagge"   src="{{ asset(vich_uploader_asset(post, 'imageFile'))}}"/>
                                        </span>
                                    </a>
                                {% endif %}
                                {% if section.template2 and 'modale2' == section.template2.code %}
                                    <!-- Modale2  -->
                                     <a style="color:{{ configs.content_link_color|default('#000000') }}" onmouseover="this.style.color='{{ configs.content_link_hover_color|default('#ffffff') }}'" onmouseout="this.style.color='{{ configs.content_link_color|default('#000000') }}'" class="portfolio-link" data-bs-toggle="modal" href="#portfolioModal{{ post.id }}">
                                        <span class="staggering">
                                            <img class="stagge"   src="{{ asset(vich_uploader_asset(post, 'imageFile')) }}"/>
                                        </span>
                                    </a>
                                {% endif %}
                            {% endif %}
                        {% endif %}
                        </div>
                    {% endfor %}
                </div>
        </div>
    </div>
</section>

<!-- Modale -->
{% include 'front/hermes/modale.html.twig' %}
