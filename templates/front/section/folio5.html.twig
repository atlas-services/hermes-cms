{# Porté depuis atlas-services/hermes release/2.2.7 (templates/front/base/hermes/template/folio5.html.twig) — chemins & configs Hermes3. #}
<!-- Portfolio Grid -->

{% set maxlengthname = 40 %}
{% set maxlengthcontent = 35 %}

<section id="{{ section.id }}" class="pb-0  px-0" style="background-color:{{ section.templateBgcolor ?? configs.content_bgcolor|default('#ffffff') }}">
    <div class="container-fluid col-12 col-lg-{{ (section.templateWidth ?? configs.folio_container_width|default(8))|col_lg }}" >
            <div id="folio" class="row mx-auto px-0">
                {% for post in  posts|sort((a, b) => a.position <=> b.position) %}
                    {% if(vich_uploader_asset(post, 'imageFile') is not null) %}
                        <div class="col-md-{{ section.templateNbCol|nb_col }} col-lg-{{ section.templateNbCol|nb_col }}  mx-auto px-0 ">
                            <div class="content_gallery text-center">
                                {% if( not section.template2) %}
                                    <img alt="" class="img-fluid img-thumbnail" src="{{ asset(vich_uploader_asset(post, 'imageFile')) }}" />
                                {% else %}
                                    {% if section.template2 and section.template2.code in ['modale1', 'modale3' ] %}
                                        <!-- Modale1  -->
                                        <a style="color:{{ configs.content_link_color|default('#000000') }}" onmouseover="this.style.color='{{ configs.content_link_hover_color|default('#ffffff') }}'" onmouseout="this.style.color='{{ configs.content_link_color|default('#000000') }}'" class="d-block mb-4 h-100 thumbnail" href="#" data-image-id="" data-name="{{ post.name }}" data-content="{{ post.content }}"  data-bs-toggle="modal"
                                           data-image ="{{ asset(vich_uploader_asset(post, 'imageFile')) }}"
                                           data-bs-target="#image-gallery-{{ section.id }}">
                                            <img alt="" class="img-fluid img-thumbnail" src="{{ asset(vich_uploader_asset(post, 'imageFile')) }}" />
                                        </a>
                                    {% endif %}
                                    {% if section.template2 and 'modale2' == section.template2.code %}
                                        <!-- Modale2  -->
                                        <a style="color:{{ configs.content_link_color|default('#000000') }}" onmouseover="this.style.color='{{ configs.content_link_hover_color|default('#ffffff') }}'" onmouseout="this.style.color='{{ configs.content_link_color|default('#000000') }}'" class="portfolio-link" data-bs-toggle="modal" href="#portfolioModal{{ post.id }}">
                                            <img alt="" class="img-fluid img-thumbnail" src="{{ asset(vich_uploader_asset(post, 'imageFile')) }}" />
                                        </a>
                                    {% endif %}
                                {% endif %}
                                {# <h6>
                                    {{ post.name|striptags|u.truncate(maxlengthname, '...') }}
                                </h6>
                                <p>
                                    {{ post.content|striptags|u.truncate(maxlengthname, '...')|raw }}
                                </p> #}
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
    </div>
</section>
<!-- Modale -->
{% include 'front/hermes/modale.html.twig' %}
