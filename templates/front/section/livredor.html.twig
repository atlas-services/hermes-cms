{% if configs.livredor_active|default(false) %}
{% set form_id = 'livredor-' ~ section.id %}
{% set pres = form_presentation %}
{% set input_class = 'form-control hermes-form-field rounded-' ~ pres.rounded_input ~ ' py-' ~ pres.py_input ~ ' my-' ~ pres.my_input %}
{% include 'front/section/_formulaire_styles.html.twig' with { form_id: form_id, presentation: pres } %}

<div class="hermes-form-{{ form_id }} text-center py-4" style="background-color: {{ pres.bgcolor }}; color: {{ pres.color }};">
    <div class="container">
        {% include 'components/Alert.html.twig' %}
        {% include 'front/section/_formulaire_header.html.twig' with {
            presentation_text: configs.livredor_presentation|default(''),
        } %}

        {{ form_start(livredor_form, {
            action: path('front_form_livredor', { _locale: app.request.locale }),
            attr: { class: 'hermes-form-' ~ form_id },
        }) }}
        <input type="hidden" name="_redirect" value="{{ app.request.uri }}">
        <input type="hidden" name="_page_label" value="{{ menu.name }}">
        {% include 'front/section/_form_spam_fields.html.twig' with { kind: 'livredor' } %}

        <div class="row justify-content-center g-3">
            <div class="col-12 col-md-6">
                {{ form_row(livredor_form.lastname, { attr: { class: input_class } }) }}
            </div>
            <div class="col-12 col-md-6">
                {{ form_row(livredor_form.firstname, { attr: { class: input_class } }) }}
            </div>
            <div class="col-12 col-lg-10">
                {{ form_row(livredor_form.message, { attr: { class: input_class } }) }}
            </div>
            <div class="col-12 text-center mt-3">
                <button type="submit" class="btn {{ pres.bgcolor_btn }} px-5">
                    {{ 'formulaire.send'|trans }}
                </button>
            </div>
        </div>
        {{ form_end(livredor_form) }}
    </div>
</div>
{% endif %}
