{# Porté depuis atlas-services/hermes release/2.2.7 (templates/front/base/hermes/template/carousel3.html.twig) — chemins & configs Hermes3. #}
<!-- Section carousel -->
<section id="{{ section.id }}" class="pb-0  px-0">
    {% set nbCol = section.templateNbCol|default(3) %}
    {% if nbCol < 1 %}{% set nbCol = 3 %}{% endif %}
    {% set col_xx = (12 / nbCol)|round(0, 'ceil') %}
    {% set carouselPosts = posts|sort((a, b) => a.position <=> b.position)|filter(post => vich_uploader_asset(post, 'imageFile') is not null) %}

    <div class="container col-12 col-lg-{{ (section.templateWidth ?? configs.carousel_multiple_container_width|default(10))|col_lg   }}" >
        <!--Carousel Wrapper-->
        {% set carouselId = 'multi-item-example-' ~ section.id %}
        <div id="{{ carouselId }}" class="carousel slide carousel-multi-item">

            <!--Controls-->
            <div class="controls-top mb-3 text-center">
                 <a style="color:{{ configs.content_link_color|default('#000000') }}" onmouseover="this.style.color='{{ configs.content_link_hover_color|default('#ffffff') }}'" onmouseout="this.style.color='{{ configs.content_link_color|default('#000000') }}'" class="btn-floating" href="#{{ carouselId }}" data-bs-target="#{{ carouselId }}" data-bs-slide="prev" role="button"><i class="fa fa-chevron-left"></i></a>
                 <a style="color:{{ configs.content_link_color|default('#000000') }}" onmouseover="this.style.color='{{ configs.content_link_hover_color|default('#ffffff') }}'" onmouseout="this.style.color='{{ configs.content_link_color|default('#000000') }}'" class="btn-floating" href="#{{ carouselId }}" data-bs-target="#{{ carouselId }}" data-bs-slide="next" role="button"><i class="fa fa-chevron-right"></i></a>
            </div>
            <!--/.Controls-->
                <!--Slides-->
                <div class="carousel-inner" role="listbox">
                    {% for slidePosts in carouselPosts|batch(nbCol) %}
                        <div class="carousel-item col-12 px-0{{ loop.first ? ' active' : '' }}">
                            <div class="row">
                                {% for post in slidePosts %}
                                    {% set imageUrl = asset(vich_uploader_asset(post, 'imageFile')) %}
                                    {% set card_class = loop.first ? '' : 'clearfix d-none d-md-block' %}
                                    <div class="col-md-{{ col_xx }} mx-auto {{ card_class }}">
                                        <div class="card mb-2 hermes-card-flair shadow-none" data-hermes-card-flair>
                                            <img class="card-img-top" src="{{ imageUrl }}"
                                                 alt="{{ (post.fileName ?? post.name)|e('html_attr') }}">
                                            <div class="card-body">
                                                <h4 class="card-title">
                                                    {% if not section.template2 %}
                                                        {{ post.name }}
                                                    {% else %}
                                                        {% if section.template2.code in ['modale1', 'modale3'] %}
                                                            <a style="color:{{ configs.content_link_color|default('#000000') }}" onmouseover="this.style.color='{{ configs.content_link_hover_color|default('#ffffff') }}'" onmouseout="this.style.color='{{ configs.content_link_color|default('#000000') }}'" class="thumbnail portfolio-link" href="#" data-image-id="" data-name="{{ post.name|e('html_attr') }}" data-content="{{ post.content|default('')|e('html_attr') }}" data-bs-toggle="modal"
                                                               data-image="{{ imageUrl }}"
                                                               data-bs-target="#image-gallery-{{ section.id }}">
                                                                {{ post.name }}
                                                            </a>
                                                        {% elseif section.template2.code == 'modale2' %}
                                                            <a style="color:{{ configs.content_link_color|default('#000000') }}" onmouseover="this.style.color='{{ configs.content_link_hover_color|default('#ffffff') }}'" onmouseout="this.style.color='{{ configs.content_link_color|default('#000000') }}'" class="portfolio-link" data-bs-toggle="modal" href="#portfolioModal{{ post.id }}">
                                                                {{ post.name }}
                                                            </a>
                                                        {% endif %}
                                                    {% endif %}
                                                </h4>
                                                <p class="card-text">{{ post.content|default('')|striptags|u.truncate(25, '...') }}</p>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% else %}
                        <div class="carousel-item active col-12 px-0">
                            <p class="text-muted text-center py-4 mb-0">{{ 'global.no_record'|trans }}</p>
                        </div>
                    {% endfor %}
                </div>
                <!--/.Slides-->
        </div>
        <!--/.Carousel Wrapper-->
    </div>
</section>


<!-- Modale  -->
{% include 'front/hermes/modale.html.twig' %}
