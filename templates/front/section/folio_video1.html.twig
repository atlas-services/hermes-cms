{# Porté depuis atlas-services/hermes release/2.2.7 (templates/front/base/hermes/template/folio_video1.html.twig) — chemins & configs Hermes3. #}
{# Port Hermes 2.2.7 folio_video1 — Hermes3 : pas de champs url/idUrl sur Post ; affichage image uniquement. #}
<section id="{{ section.id }}" class="pb-0 mx-auto px-0">
    <div class="container-fluid col-12 col-lg-{{ (section.templateWidth ?? configs.folio_container_width|default(8))|col_lg }} mx-auto px-0">
        <div id="folio" class="row">
            {% for post in posts|sort((a, b) => a.position <=> b.position) %}
                {% if vich_uploader_asset(post, 'imageFile') is not null %}
                    <div class="col-lg-{{ (section.templateWidth ?? configs.folio_container_width|default(8))|col_lg(section) }} col-md-{{ (section.templateWidth ?? configs.folio_container_width|default(8))|col_lg(section) }} col-12 text-center mb-4">
                        <div class="col-12 text-center">
                            <img alt="{{ post.fileName ?? post.name }}" class="img-fluid img-thumbnail" src="{{ asset(vich_uploader_asset(post, 'imageFile')) }}" />
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</section>
