{# Porté depuis atlas-services/hermes release/2.2.7 (templates/front/base/hermes/template/folio3.html.twig) — chemins & configs Hermes3. #}
<!-- Portfolio Grid -->
<section id="{{ section.id }}" class="pb-0  px-0">
    <div class="container-fluid col-12 col-lg-{{ (section.templateWidth ?? configs.folio_container_width|default(8))|col_lg }}">
        <div class="row pt-md-3 pt-1 pb-1 pb-md-3">
            {% for post in  posts|sort((a, b) => a.position <=> b.position) %}
                {% if(vich_uploader_asset(post, 'imageFile') is not null) %}
                    <div class="row mx-auto col-md-{{ section.templateNbCol|nb_col }} col-lg-{{ section.templateNbCol|nb_col }} col-12">
                          <h5>
                            {% if section.template2 and 'modale1' == section.template2.code %}
                                <!-- Modale1  -->
                                <a style="color:{{ configs.content_link_color|default('#000000') }}" onmouseover="this.style.color='{{ configs.content_link_hover_color|default('#ffffff') }}'" onmouseout="this.style.color='{{ configs.content_link_color|default('#000000') }}'" class="d-block mb-4 h-100 thumbnail" href="#" data-image-id="" data-name="{{ post.name }}" data-content="{{ post.content }}" data-bs-toggle="modal"
                                   data-image ="{{ asset(vich_uploader_asset(post, 'imageFile')) }}"
                                   data-bs-target="#image-gallery-{{ section.id }}">
                                    <img class="img-fluid" src="{{ asset(vich_uploader_asset(post, 'imageFile')) }}"/>
                 
                                </a>
                            {% endif %}
                            {% if section.template2 and 'modale2' == section.template2.code %}
                                <!-- Modale2  -->
                                <a class="text-decoration-none portfolio-link" style="color:{{ configs.content_link_color|default('#000000') }}" onmouseover="this.style.color='{{ configs.content_link_hover_color|default('#ffffff') }}'" onmouseout="this.style.color='{{ configs.content_link_color|default('#000000') }}'" data-bs-toggle="modal" href="#portfolioModal{{ post.id }}">
                                         <img class="img-fluid" src="{{ asset(vich_uploader_asset(post, 'imageFile')) }}"/>
                                </a>
                            {% endif %}
                        </h5>
                        {# <p> <span class="px-2 px-md-5">{{ post.content|raw }}</span> </p> #}
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</section>

<!-- Modale -->
{% include 'front/hermes/modale2.html.twig' %}
