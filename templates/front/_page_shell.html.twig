{# Enveloppe page front : navbar, zone sections, footer #}
{% set navBarType = configs.nav_bar|default('base') %}
{% if navBarType == 'left' %}
    {% set navBarType = 'menu_left' %}
{% endif %}
{# Menu base : true = reste en haut au scroll (sticky-top sur <header>) ; false = défile avec le contenu.
   Futur : configs.nav_base_fixed_top (hermes_configs.yaml, groupe nav) #}
{% set nav_base_fixed_top = true %}
{% set navBaseSticky = navBarType == 'base' and nav_base_fixed_top %}
<div class="d-flex flex-column min-vh-100{{ navBaseSticky ? ' hermes-layout-nav-base-fixed' : '' }}">
    <header class="mb-0 w-100{{ navBaseSticky ? ' sticky-top hermes-nav-base-header' : '' }}"
            {% if navBaseSticky %}style="background-color: {{ configs.nav_bgcolor|default('#ffffff') }}; z-index: 1030;"{% endif %}>
        {% set navbarTemplate = 'front/navbar/' ~ navBarType ~ '.html.twig' %}
        {% include [navbarTemplate, 'front/navbar/base.html.twig'] with {
            menu: menu|default(null),
            menuTree: menuTree,
            configs: configs,
        } %}
    </header>

    <div id="section_top"></div>

    {% include 'front/_chevrons.html.twig' %}

    <main class="flex-grow-1{% if navBarType == 'left' %} hermes-nav-menu-left-main{% endif %}">
        <div class="container-fluid px-0">
            {# Hermes 2.2.7 js-front.js : couleur des liens .link dans contenu libre #}
            <input type="hidden" id="content_link_color" value="{{ configs.content_link_color|default('#000000')|e('html_attr') }}">
            <input type="hidden" id="content_link_hover_color" value="{{ configs.content_link_hover_color|default('#ffffff')|e('html_attr') }}">
            {% block page_main %}{% endblock %}
        </div>
    </main>

    <footer class="mt-auto{% if navBarType == 'left' %} hermes-nav-menu-left-main{% endif %}">
        <div class="container">
            <p>&copy; {{ "now"|date('Y') }} {{ configs.title|default('') }}</p>
        </div>
    </footer>

    <section id="section_bottom" class="hermes-section-bottom-anchor" aria-hidden="true"></section>
</div>
