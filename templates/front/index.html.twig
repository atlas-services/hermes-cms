{% extends 'base.html.twig' %}

{% block title %}{{ menu.name }}{% endblock %}

{% block body %}
<div class="d-flex flex-column min-vh-100">
    <header class="mb-4">
        {% set navbarTemplate = 'front/navbar/' ~ (configs.nav_bar|default('base')) ~ '.html.twig' %}
        {% include [navbarTemplate, 'front/navbar/base.html.twig'] with { menu: menu, menuTree: menuTree, configs: configs } %}
    </header>

    <main class="flex-grow-1">
        <div class="container">
            <h1>{{ menu.name }}</h1>
            {% for section in sections %}
                <section>
                    {% for post in section.posts %}
                        <article>
                            <h3>{{ post.name }}</h3>
                            <div class="post-content">{{ post.content|raw }}</div>
                        </article>
                    {% endfor %}
                </section>
            {% endfor %}
        </div>
    </main>

    <footer class="mt-auto">
        <div class="container">
            <p>&copy; {{ "now"|date('Y') }} Mon Site</p>
        </div>
    </footer>
</div>

{% endblock %}
