{% import 'front/navbar/_navbar_macros.html.twig' as nav %}

{% set navContainerWidth = (configs.nav_container_width|default(12) + 0)|round(0, 'floor') %}
{% set navContainerWidth = navContainerWidth < 1 ? 12 : (navContainerWidth > 12 ? 12 : navContainerWidth) %}
{% set navOffset = (configs.nav_offset|default(0) + 0)|round(0, 'floor') %}
{% set navOffset = navOffset < 0 ? 0 : (navOffset > 11 ? 11 : navOffset) %}
{% set navEspacement = (configs.nav_espacement|default(0) + 0)|round(0, 'floor') %}
{% set navEspacement = navEspacement < 0 ? 0 : (navEspacement > 5 ? 5 : navEspacement) %}
{% set navLinkPx = (configs.nav_link_px|default(2) + 0)|round(0, 'floor') %}
{% set navLinkPx = navLinkPx < 0 ? 0 : (navLinkPx > 5 ? 5 : navLinkPx) %}
{% set navLinkPy = (configs.nav_link_py|default(2) + 0)|round(0, 'floor') %}
{% set navLinkPy = navLinkPy < 0 ? 0 : (navLinkPy > 5 ? 5 : navLinkPy) %}
{% set navLinkRounded = (configs.nav_link_rounded|default(0) + 0)|round(0, 'floor') %}
{% set navLinkRounded = navLinkRounded < 0 ? 0 : (navLinkRounded > 5 ? 5 : navLinkRounded) %}
{% set navSubMenuMx = (configs.nav_sub_menu_mx|default(0) + 0)|round(0, 'floor') %}
{% set navSubMenuMx = navSubMenuMx < 0 ? 0 : (navSubMenuMx > 5 ? 5 : navSubMenuMx) %}
{% set navMenuTextSize = configs.nav_menu_text_size|default('h6') %}
{% set navSubMenuTextSize = configs.nav_sub_menu_text_size|default('h6') %}
{% set navHeight = configs.nav_height|default('90px') %}
{% set logoConfig = configs.logo|default(null) %}
{% set logoUrl = logoConfig ? vich_uploader_asset(logoConfig, 'imageFile') : null %}
{% set logoTop = configs.affiche_logo_top|default(false) %}
{% set logoLeftOffset = (logoConfig and attribute(logoConfig, 'value') is not null) ? attribute(logoConfig, 'value') : '0px' %}
{% set navAosCfg = configs.nav_data_aos_active|default(false) %}
{% set navAosActive = navAosCfg is same as(true) or navAosCfg in [1, '1', 'true', 'on'] %}
{% set navAosEffect = configs.nav_data_aos|default('fade-up') %}
{% set navAosDuration = (configs.nav_data_aos_duration|default(1000) + 0)|round(0, 'floor') %}

<nav class="navbar navbar-expand-lg rounded w-100"
     style="
        background-color: {{ configs.nav_bgcolor|default('#ffffff') }};
        font-family: {{ configs.nav_font_family|default('inherit') }};
        min-height: {{ navHeight }};
     ">
    <div class="container-fluid px-0">
        <div class="row w-100 g-0">
            <div class="col-12 col-lg-{{ navContainerWidth }}">
                {% if logoUrl %}
                    <div class="w-100 text-center d-lg-none mb-2">
                        <img src="{{ asset(logoUrl) }}"
                             alt="Logo"
                             class="img-fluid"
                             style="max-width: 100%; height: auto;">
                    </div>
                {% endif %}

                {% if logoUrl and logoTop %}
                    <div class="w-100 text-start d-none d-lg-block mb-2">
                        <img src="{{ asset(logoUrl) }}"
                             alt="Logo"
                             class="img-fluid"
                             style="max-width: 100%; height: auto; margin-left: {{ logoLeftOffset }};">
                    </div>
                {% endif %}

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#frontNavbarNav" aria-controls="frontNavbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="frontNavbarNav">
                    <div class="row gx-0 align-items-lg-center w-100 mx-0">
                        {% if logoUrl and not logoTop %}
                            <div class="col-auto">
                                <a class="navbar-brand d-none d-lg-block mb-lg-0 me-{{ navEspacement }}" href="{{ path('front_root') }}">
                                    <img src="{{ asset(logoUrl) }}"
                                         alt="Logo"
                                         class="img-fluid"
                                         style="max-width: 100%; height: auto; margin-left: {{ logoLeftOffset }};">
                                </a>
                            </div>
                        {% endif %}
                        <div class="col {{ navOffset > 0 ? 'offset-lg-' ~ navOffset : '' }}">
                            {% set navLocaleSwitcherPosition = configs.nav_locale_switcher_position|default('below') %}
                            {% if navLocaleSwitcherPosition not in ['below', 'inline'] %}
                                {% set navLocaleSwitcherPosition = 'below' %}
                            {% endif %}
                            <div class="d-lg-flex align-items-lg-center w-100">
                                <ul class="navbar-nav mb-2 mb-lg-0 align-items-lg-center{{ navLocaleSwitcherPosition == 'inline' ? ' flex-grow-1' : '' }}"
                                    style="
                                        min-height: {{ navHeight }};
                                        background-color: {{ configs.nav_bgcolor|default('#ffffff') }};
                                    ">
                                    {{ nav.renderMenu(menuTree, menu, configs, navEspacement, navLinkPx, navLinkPy, navLinkRounded, navSubMenuMx, navMenuTextSize, navSubMenuTextSize, navAosActive, navAosEffect, navAosDuration, true) }}
                                </ul>
                                {% if navLocaleSwitcherPosition == 'inline' %}
                                    {% include 'front/navbar/_locale_switcher.html.twig' with {
                                        placement: 'inline',
                                        menu: menu|default(null),
                                        configs: configs,
                                    } %}
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</nav>
