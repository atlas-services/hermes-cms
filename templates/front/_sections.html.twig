{# Boucle sections front (pages menu, contact, etc.) #}
{% for block in sectionsForFront %}
    {% set section = block.section %}
    {% set posts = block.posts %}
    {% set effW = mainW < secW ? mainW : secW %}
    {% set mainType = section.template ? section.template.type|trim|lower : '' %}
    {% set mainCode = section.template ? section.template.code : '' %}
    {% if mainType == 'formulaire' and mainCode != '' %}
        {% set formWidthKey = mainCode ~ '_width' %}
        {% set formW = (configs[formWidthKey]|default(effW) + 0)|round(0, 'floor') %}
        {% set formW = formW < 1 ? 1 : (formW > 12 ? 12 : formW) %}
        {% set effW = mainW < formW ? mainW : formW %}
    {% endif %}
    <div class="row justify-content-center mx-0">
        <div class="col-12 col-lg-{{ effW }} mx-auto px-0 ">
            {% set sectionBg = section.isTransparent ? 'transparent' : section.templateBgcolor %}
            {% set isListeSectionTemplate = mainType == 'liste' and mainCode != '' %}
            <section class="mx-auto px-0" style="background-color: {{ sectionBg }}"{% if not isListeSectionTemplate %} id="{{ section.id }}"{% endif %}>
                {% set sectionColSm = (section.templateWidth|default(10) + 0)|round(0, 'floor') %}
                <div class="section-content col-sm-{{ sectionColSm }} mx-auto">
                    {% if mainType == 'liste' and mainCode != '' %}
                        {% include 'front/section/' ~ mainCode ~ '.html.twig' %}
                    {% elseif mainType == 'libre' %}
                        {% include 'front/section/libre.html.twig' %}
                    {% elseif mainType == 'formulaire' and mainCode != '' %}
                        {% include 'front/section/' ~ mainCode ~ '.html.twig' with {
                            section: section,
                            menu: menu,
                            posts: posts,
                        }|merge(hermes_formulaire_vars(mainCode, configs)) %}
                    {% else %}
                        {% for post in posts %}
                            <article class="my-0">
                                <div class="post-content">{{ post.content|raw }}</div>
                            </article>
                        {% endfor %}
                    {% endif %}
                </div>
            </section>
        </div>
    </div>
{% endfor %}
