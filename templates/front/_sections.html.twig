{# Boucle sections front (pages menu, contact, etc.) — pas de marge verticale entre blocs (gy-0, section.my-0). #}
<div class="hermes-front-sections">
{% for block in sectionsForFront %}
    {% set section = block.section %}
    {% set posts = block.posts %}
    {% set effW = section.templateWidth|default(10)|col_lg %}
    {% set mainType = section.template ? section.template.type|trim|lower : '' %}
    {% set mainCode = section.template ? section.template.code : '' %}
    {% set shouldDeferTopbarDisplay = topbarDismissOnce|default(false) and section.topbarSection %}
    <div class="row justify-content-center mx-0 gy-0{{ shouldDeferTopbarDisplay ? ' d-none' : '' }}"
         {% if topbarDismissOnce|default(false) and section.topbarSection %}
             data-hermes-topbar-section-id="{{ section.id }}"
             data-hermes-topbar-pending-display="true"
         {% endif %}>
        <div class="col-12 col-lg-{{ effW }} mx-auto px-0">
            {% set sectionBg = hermes_section_bgcolor(section, configs) %}
            {% set sectionColor = hermes_section_text_color(section, configs) %}
            {% set isListeSectionTemplate = mainType == 'liste' and mainCode != '' %}
            <section class="mx-auto px-0 my-0{{ shouldDeferTopbarDisplay ? ' position-relative' : '' }}" style="background-color: {{ sectionBg }}; color: {{ sectionColor }};"{% if not isListeSectionTemplate %} id="{{ section.id }}"{% endif %}>
                {% if shouldDeferTopbarDisplay %}
                    <button type="button"
                            class="btn-close position-absolute top-0 end-0 m-2"
                            data-hermes-topbar-dismiss
                            aria-label="{{ 'global.close'|trans|default('Fermer') }}"></button>
                {% endif %}
                <div class="section-content mx-auto">
                    {% if mainType == 'liste' and mainCode != '' %}
                        {% include 'front/section/' ~ mainCode ~ '.html.twig' %}
                    {% elseif mainType in ['libre', 'footer', 'topbar'] %}
                        {% include 'front/section/libre.html.twig' %}
                    {% elseif mainType == 'formulaire' and mainCode != '' %}
                        {% set formulaireContext = {
                            section: section,
                            menu: menu,
                            posts: posts,
                            configs: configs,
                        } %}
                        {% if mainCode != 'booking' %}
                            {% set formulaireContext = formulaireContext|merge(hermes_formulaire_vars(mainCode, configs)) %}
                        {% endif %}
                        {% include 'front/section/' ~ mainCode ~ '.html.twig' with formulaireContext %}
                    {% else %}
                        {% for post in posts %}
                            <article class="my-0">
                                <div class="post-content">{{ post.content|raw }}</div>
                            </article>
                        {% endfor %}
                    {% endif %}
                </div>
            </section>
        </div>
    </div>
{% endfor %}
</div>
