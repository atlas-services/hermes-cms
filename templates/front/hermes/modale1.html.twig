{# Port Hermes release/2.2.7 : modale1 — responsive : modale + image pleine largeur ; ≥ lg : largeur dialog selon template2Width/12 ; 12 = toujours plein écran. #}
{% set _tw2 = (section.rawTemplate2Width ?? (configs.modale_container_width|default(6)))|col_lg %}
{% set _modalVw = 'min(calc(100vw - 1.5rem), calc((100vw - 1.5rem) * ' ~ _tw2 ~ ' / 12))' %}
{% set _modalVh = 'min(calc(100vh - 2rem), calc((100vh - 2rem) * ' ~ _tw2 ~ ' / 12))' %}
<style>
@media (max-width: 991.98px) {
  #image-gallery-{{ section.id }}.modal {
    padding: 0 !important;
    margin: 0 !important;
  }
  {% if _tw2 != 12 %}
  #image-gallery-{{ section.id }} > .modal-dialog {
    width: 100vw !important;
    max-width: none !important;
    height: 100% !important;
    margin: 0 !important;
    max-height: none !important;
  }
  {% endif %}
  #image-gallery-{{ section.id }} .modal-content {
    width: 100% !important;
    max-width: none !important;
    border-radius: 0 !important;
    margin: 0 !important;
  }
  #image-gallery-{{ section.id }} .modal-header {
    padding-left: 0.75rem;
    padding-right: 0.75rem;
  }
  #image-gallery-{{ section.id }} .modal-body {
    padding-left: 0 !important;
    padding-right: 0 !important;
  }
  #image-gallery-{{ section.id }} .modal-body > .w-100 {
    max-width: none !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
  }
  #image-gallery-{{ section.id }} .image-gallery-image {
    width: 100% !important;
    max-width: none !important;
    border-radius: 0 !important;
    object-fit: contain;
    max-height: min(88vh, 100vw) !important;
  }
}
{% if _tw2 != 12 %}
@media (min-width: 992px) {
  #image-gallery-{{ section.id }} > .modal-dialog {
    width: {{ _modalVw }} !important;
    max-width: {{ _modalVw }} !important;
    max-height: {{ _modalVh }} !important;
  }
}
{% endif %}
</style>
<div
    class="modal fade"
    id="image-gallery-{{ section.id }}"
    tabindex="-1"
    aria-labelledby="image-gallery-title-{{ section.id }}"
    aria-hidden="true"
    data-controller="image-gallery"
>
    <div
        class="modal-dialog modal-dialog-scrollable{% if _tw2 == 12 %} modal-fullscreen{% else %} modal-dialog-centered mx-auto{% endif %}"
    >
        <div class="modal-content w-100">
            {% include 'front/hermes/includes/_modale1.html.twig' %}
        </div>
    </div>
</div>
