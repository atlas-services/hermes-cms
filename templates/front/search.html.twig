{% extends 'front/base.html.twig' %}

{% block title %}{{ 'front.search.title'|trans }}{% endblock %}

{% block body %}
{% embed 'front/_page_shell.html.twig' with { menu: menu|default(null), menuTree: menuTree, configs: configs } %}
    {% block page_main %}
        <section class="container py-5">
            <div class="row justify-content-center">
                <div class="col-12 col-lg-10">
                    <h1 class="h2 mb-3">{{ 'front.search.title'|trans }}</h1>

                    <form class="mb-4" action="{{ path('search_content', { _locale: app.request.locale }) }}" method="get" role="search">
                        <label class="form-label" for="front-search-page-input">{{ 'front.search.label'|trans }}</label>
                        <div class="input-group">
                            <input id="front-search-page-input"
                                   class="form-control"
                                   type="search"
                                   name="q"
                                   value="{{ query|default('')|e('html_attr') }}"
                                   placeholder="{{ 'front.search.placeholder'|trans }}"
                                   minlength="2"
                                   autofocus>
                            <button class="btn btn-primary" type="submit">{{ 'front.search.submit'|trans }}</button>
                        </div>
                        <div class="form-text">{{ 'front.search.min_length'|trans }}</div>
                    </form>

                    {% if query|default('')|length >= 2 %}
                        <p class="text-muted">
                            {{ 'front.search.count'|trans({ '%count%': results|length, '%query%': query }) }}
                        </p>

                        {% for result in results %}
                            <article class="border-bottom py-3">
                                <h2 class="h5 mb-1">
                                    <a href="{{ result.url }}" class="text-decoration-none">
                                        {{ result.title }}
                                    </a>
                                </h2>
                                {% if result.page %}
                                    <p class="small text-muted mb-2">{{ 'front.search.in_page'|trans({ '%page%': result.page }) }}</p>
                                {% endif %}
                                {% if result.excerpt %}
                                    <p class="mb-0">{{ result.excerpt }}</p>
                                {% endif %}
                            </article>
                        {% else %}
                            <div class="alert alert-info mb-0">{{ 'front.search.no_results'|trans }}</div>
                        {% endfor %}
                    {% elseif query|default('') is not same as('') %}
                        <div class="alert alert-warning mb-0">{{ 'front.search.too_short'|trans }}</div>
                    {% endif %}
                </div>
            </div>
        </section>
    {% endblock %}
{% endembed %}
{% endblock %}
