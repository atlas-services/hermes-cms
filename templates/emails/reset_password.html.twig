<!DOCTYPE html>
<html lang="{{ locale|default('fr') }}">
<head>
    <meta charset="UTF-8">
    <title>{{ 'security.email.reset_password.subject'|trans({}, 'messages', locale|default('fr')) }}</title>
</head>
<body>
    {% set displayName = userIdentifier is defined and userIdentifier ? ' ' ~ userIdentifier : '' %}
    <p>{{ 'security.email.reset_password.greeting'|trans({'%name%': displayName}, 'messages', locale|default('fr')) }}</p>
    <p>{{ 'security.email.reset_password.intro'|trans({}, 'messages', locale|default('fr')) }}</p>
    <p>
        <a href="{{ resetUrl }}">{{ 'security.email.reset_password.link'|trans({}, 'messages', locale|default('fr')) }}</a>
    </p>
    <p class="text-muted" style="color:#666;font-size:small;">
        {{ 'security.email.reset_password.ignore'|trans({}, 'messages', locale|default('fr')) }}
    </p>
</body>
</html>
