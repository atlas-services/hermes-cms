{# Erreurs de champs : clés de traduction dans le domaine messages (form.contact.*, etc.) #}
{% block form_errors %}
    {%- if errors|length > 0 -%}
        <ul>
            {%- for error in errors -%}
                <li>{{ error.message|trans(error.messageParameters, 'messages') }}</li>
            {%- endfor -%}
        </ul>
    {%- endif -%}
{% endblock %}
