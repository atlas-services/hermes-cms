{% extends '/admin/base.html.twig' %}

{% block title %}{{ 'form.label.menus'|trans }}{% endblock %}

{% block content %}
    <div>
        <h1>Menus</h1>

        <a class="btn btn-success mb-3" href="{{ path('menu_new') }}">
            {{ 'form.label.create'|trans() }}
        </a>

        {# 🌳 ARBRE COMPLET #}
        {{ component('Menu', { menus: menus }) }}

    {% if(menus|length) > 0 %}
            <a class="btn btn-success mt-3" href="{{ path('menu_new') }}">
                {{ 'form.label.create'|trans() }}
            </a>
        </div>
    {% endif %}
{% endblock %}
