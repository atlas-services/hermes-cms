{% extends '/admin/base.html.twig' %}

{% block title %}{{ 'form.label.menus'|trans }}{% endblock %}

{% block content %}
    <div>
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <h1 class="mb-0">{{ 'form.label.menus'|trans }}</h1>
            <form method="get" class="d-flex align-items-center gap-2">
                {{ include('admin/_menu_locale_filter.html.twig') }}
            </form>
        </div>

        {{ include('admin/_btn_add_icon.html.twig', {
            href: path('menu_new', menu_index_query),
            label: 'form.label.create'|trans(),
            btn_class: 'btn btn-success mb-3',
        }) }}

        {{ component('Menu', { menus: menus, menu_locale: menu_locale }) }}

        {% if menus|length > 0 %}
            {{ include('admin/_btn_add_icon.html.twig', {
                href: path('menu_new', menu_index_query),
                label: 'form.label.create'|trans(),
                btn_class: 'btn btn-success mt-3',
            }) }}
        {% endif %}
    </div>
{% endblock %}
