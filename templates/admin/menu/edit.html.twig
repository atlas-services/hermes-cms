{% extends '/admin/base.html.twig' %}

{% block title %}{{ 'form.label.menu_edit'|trans }}{% endblock %}

{% block content %}
    <h1>{{ 'form.label.menu_edit'|trans }}</h1>

    {{ include('admin/menu/_form.html.twig', {'button_label': 'form.label.update'|trans()}) }}

    {% if menu.sections|length > 0 %}
        <section class="mt-5">
            <h2>Sections</h2>

            {% for section in menu.sections %}
                <div class="card mb-3">
                    <div class="card-header">
                        Section {{ section.position }}
                        {% if section.template %}
                            - {{ section.template.name }}
                        {% endif %}
                    </div>
                    <div class="card-body">
                        {% if section.posts|length > 0 %}
                            <ul class="list-group">
                                {% for post in section.posts %}
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        {{ post.name }}
                                        <a class="btn btn-sm btn-outline-success" href="{{ path('post_edit', {'id': post.id}) }}">
                                            {{ 'form.label.edit'|trans() }}
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <p>{{ 'form.label.no_record'|trans() }}</p>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </section>
    {% endif %}

    {% if menu.isLeaf() %}
        <div class="mt-3">
            <a class="btn btn-success" href="{{ path('post_new', {'id': menu.id}) }}">Ajouter un post</a>
        </div>
    {% endif %}

    <a class="btn btn-info my-3" href="{{ path('menu_index', menu_locale is defined ? { menu_locale: menu_locale } : {}) }}">{{ 'form.label.back_to_list'|trans() }}</a>

    {{ include('admin/menu/_delete_form.html.twig') }}
{% endblock %}
