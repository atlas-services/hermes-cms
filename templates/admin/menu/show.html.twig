{% extends '/admin/base.html.twig' %}

{% block title %}{{ 'form.label.menu_show'|trans }}{% endblock %}

{% block content %}
    <h1>{{ 'form.label.menu_show'|trans }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ menu.id }}</td>
            </tr>
            <tr>
                <th>{{ 'form.label.name'|trans() }}</th>
                <td>{{ menu.name }}</td>
            </tr>
            <tr>
                <th>{{ 'form.label.position'|trans() }}</th>
                <td>{{ menu.position }}</td>
            </tr>
            <tr>
                <th>{{ 'form.label.slug'|trans() }}</th>
                <td>{{ menu.slug }}</td>
            </tr>
            <tr>
                <th>{{ 'form.label.active'|trans() }}</th>
                <td>{{ menu.active ? 'Yes' : 'No' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('menu_index') }}">{{ 'form.label.back_to_list'|trans() }}</a>

    <a href="{{ path('menu_edit', {'id': menu.id}) }}">{{ 'form.label.edit'|trans() }}</a>

    {{ include('admin/menu/_delete_form.html.twig') }}
{% endblock %}
