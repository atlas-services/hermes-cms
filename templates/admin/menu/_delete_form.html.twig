<form method="post" action="{{ path('menu_delete', {'id': menu.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    {# <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ menu.id) }}"> #}
    <input type="hidden" name="_token" value="{{ csrf_token('delete_' ~ menu.id|e) }}">
    {# <input type="hidden" name="_token" value="{{ csrf_token('delete') }}"> #}
    <button class="btn btn-danger">{{ 'form.label.delete'|trans() }}</button>
</form>
