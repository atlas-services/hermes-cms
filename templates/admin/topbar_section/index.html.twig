{% extends '/admin/base.html.twig' %}

{% block title %}{{ 'admin.topbar_sections.title'|trans }}{% endblock %}

{% block content %}
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <h1 class="mb-0">{{ 'admin.topbar_sections.title'|trans }}</h1>
                <form method="get" class="d-flex align-items-center gap-2">
                    {{ include('admin/_menu_locale_filter.html.twig') }}
                </form>
            </div>
            <p class="text-muted mb-0">{{ 'admin.topbar_sections.help'|trans }}</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="{{ path('config_index', { type: 'topbar', _locale: app.request.locale }) }}">
                {{ 'config.affiche_list_topbar'|trans }}
            </a>
            <form method="post" action="{{ path('admin_topbar_sections_new', { _locale: app.request.locale }) }}">
                <input type="hidden" name="locale" value="{{ menu_locale }}">
                {{ include('admin/_btn_add_icon.html.twig', {
                    label: 'admin.topbar_sections.add_section'|trans,
                    btn_class: 'btn btn-success',
                }) }}
            </form>
        </div>
    </div>

    {{ include('admin/section/_list.html.twig', {
        sections: sections,
        menu_locales: availableLocales|default([]),
        menu_locale: menu_locale,
        sectionModaleChoices: [],
        sectionListeTemplateChoices: {},
        footerSectionList: true,
    }) }}
{% endblock %}
