{# Formulaire POST inline avec icône poubelle (liste admin). #}
{% set btn_class = btn_class is defined ? btn_class : 'btn btn-outline-danger btn-sm' %}
{% set _icon_height = icon_height is defined ? icon_height : '16px' %}
<form method="post"
      action="{{ action }}"
      class="d-inline{{ form_class|default('') }}"
      {% if confirm_message is defined and confirm_message %}
          data-confirm="{{ confirm_message|e('html_attr') }}"
          onsubmit="return confirm(this.getAttribute('data-confirm'));"
      {% endif %}>
    <input type="hidden" name="_token" value="{{ csrf_token }}">
    {% for field in hidden_fields|default([]) %}
        <input type="hidden" name="{{ field.name }}" value="{{ field.value }}">
    {% endfor %}
    <button type="submit" class="{{ btn_class }}" title="{{ 'form.label.delete'|trans }}">
        {{ ux_icon('fa:trash', {height: _icon_height}) }}
        <span class="visually-hidden">{{ 'form.label.delete'|trans }}</span>
    </button>
</form>
