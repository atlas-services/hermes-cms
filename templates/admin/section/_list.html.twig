<table class="table table-hover">
    <thead>
        <tr>
            <th>{{ 'form.label.active'|trans }}</th>
            <th>{{ 'form.label.section_width_1_to_12'|trans }}</th>
            <th>{{ 'Template' }}</th>
            <th>{{ 'form.label.section_modal'|trans }}</th>
            <th>{{ 'form.label.section_modal_width_1_to_12'|trans }}</th>
            <th>{{ 'form.label.section_bgcolor'|trans }}</th>
            <th>{{ 'form.label.section_list_options'|trans }}</th>
            <th>{{ 'Posts' }}</th>
            <th>{{ 'form.label.actions'|trans() }}</th>
        </tr>
    </thead>
    <tbody
        data-controller="move-item"
        data-type="section"
        data-locale="{{ app.request.locale }}"
    >
        {% for section in sections %}
            {% set isListe = section.template and section.template.type == 'liste' %}
            <tr class="list-items align-middle" data-move-item-target="item" data-item-id="{{ section.id }}">
                <td>
                    <div class="form-check form-switch form-switch-sm my-0">
                        <input
                            data-controller="active-item"
                            type="checkbox"
                            class="form-check-input bg-success"
                            data-action="click->active-item#switch"
                            {{ section.active ? 'checked' : '' }}
                        >
                    </div>
                </td>
                <td>
                    {% set sectionWidth = section.templateWidth ?? 10 %}
                    <select
                        class="form-select form-select-sm w-auto"
                        aria-label="{{ 'form.label.section_width_1_to_12'|trans }}"
                        data-controller="active-item"
                        data-action="change->active-item#persistTemplateWidth"
                    >
                        {% for w in 1..12 %}
                            <option value="{{ w }}" {{ sectionWidth == w ? 'selected' : '' }}>{{ w }}</option>
                        {% endfor %}
                    </select>
                </td>
                <td>
                    {{ section.template ? section.template.name : 'Aucun template' }}
                </td>
                <td>
                    {% if isListe %}
                        {% set currentModalCode = section.template2 ? section.template2.code : '' %}
                        <select
                            class="form-select form-select-sm w-auto"
                            aria-label="{{ 'form.label.section_modal'|trans }}"
                            data-controller="active-item"
                            data-action="change->active-item#persistSectionTemplate2"
                        >
                            <option value="" {{ currentModalCode == '' ? 'selected' : '' }}>{{ 'form.label.section_modal_none'|trans }}</option>
                            {% for m in sectionModaleChoices|default([]) %}
                                <option value="{{ m.code }}" {{ currentModalCode == m.code ? 'selected' : '' }}>{{ m.name }}</option>
                            {% endfor %}
                        </select>
                    {% else %}
                        <span class="text-muted">—</span>
                    {% endif %}
                </td>
                <td>
                    {% if isListe %}
                        {% set modal2W = section.rawTemplate2Width ?? 4 %}
                        <select
                            class="form-select form-select-sm w-auto"
                            aria-label="{{ 'form.label.section_modal_width_1_to_12'|trans }}"
                            data-controller="active-item"
                            data-action="change->active-item#persistTemplate2Width"
                        >
                            {% for w in 1..12 %}
                                <option value="{{ w }}" {{ modal2W == w ? 'selected' : '' }}>{{ w }}</option>
                            {% endfor %}
                        </select>
                    {% else %}
                        <span class="text-muted">—</span>
                    {% endif %}
                </td>
                <td>
                    <div class="d-flex flex-column gap-1 align-items-start">
                        <div class="form-check form-switch form-switch-sm my-0">
                            <input
                                type="checkbox"
                                class="form-check-input"
                                data-controller="active-item"
                                data-action="change->active-item#persistSectionTransparent"
                                {{ section.isTransparent ? 'checked' : '' }}
                                id="section-transparent-{{ section.id }}"
                            >
                            <label class="form-check-label small" for="section-transparent-{{ section.id }}">{{ 'form.label.section_transparent'|trans }}</label>
                        </div>
                        {% set sectionBgHex = section.rawTemplateBgcolor %}
                        <input
                            type="color"
                            class="form-control form-control-color form-control-sm js-section-bgcolor"
                            value="{{ sectionBgHex is not null and sectionBgHex starts with '#' ? sectionBgHex : '#ffffff' }}"
                            data-controller="active-item"
                            data-action="change->active-item#persistSectionTemplateBgcolor"
                            {{ section.isTransparent ? 'disabled' : '' }}
                            title="{{ 'form.label.section_bgcolor'|trans }}"
                        >
                    </div>
                </td>
                <td>
                    {% if isListe %}
                        <div class="d-flex flex-column gap-1 align-items-start">
                            <label class="small text-muted mb-0">{{ 'form.label.section_nb_col'|trans }}</label>
                            <select
                                class="form-select form-select-sm w-auto"
                                aria-label="{{ 'form.label.section_nb_col'|trans }}"
                                data-controller="active-item"
                                data-action="change->active-item#persistSectionTemplateNbCol"
                            >
                                {% set nbCol = section.templateNbCol %}
                                {% for n in 1..8 %}
                                    <option value="{{ n }}" {{ nbCol == n ? 'selected' : '' }}>{{ n }}</option>
                                {% endfor %}
                            </select>
                            <label class="small text-muted mb-0">{{ 'form.label.section_image_filter'|trans }}</label>
                            <input
                                type="text"
                                class="form-control form-control-sm w-auto"
                                value="{{ section.templateImageFilter }}"
                                placeholder="bd_154"
                                data-controller="active-item"
                                data-action="change->active-item#persistSectionTemplateImageFilter"
                            >
                        </div>
                    {% else %}
                        <span class="text-muted">—</span>
                    {% endif %}
                </td>
                <td>
                    {% if section.posts|length > 0 %}
                        <ul class="list-unstyled mb-0">
                            {% for post in section.posts %}
                                <li>
                                    <a href="{{ path('post_edit', {id: post.id}) }}">{{ post.name }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <span class="text-muted">Aucun post</span>
                    {% endif %}
                </td>
                <td>
                    <button class="btn btn-outline-success btn-sm me-1" data-action="click->move-item#moveUp">↑</button>
                    <button class="btn btn-outline-success btn-sm me-3" data-action="click->move-item#moveDown">↓</button>
                    <a class="btn btn-success btn-sm" href="{{ path('post_new_section', {id: section.id}) }}">
                        {{ 'Ajouter un post' }}
                    </a>
                    {% if isListe %}
                        <a class="btn btn-outline-primary btn-sm ms-1" href="{{ path('post_bulk_import_media_images', { id: section.id }) }}">
                            {{ 'admin.post_bulk.add_images'|trans }}
                        </a>
                        <form method="post" action="{{ path('section_clear_liste_images', { id: section.id }) }}" class="d-inline" data-confirm="{{ 'admin.section.confirm_clear_images'|trans|e('html_attr') }}" onsubmit="return confirm(this.getAttribute('data-confirm'));">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_liste_posts_' ~ section.id) }}">
                            <button type="submit" class="btn btn-outline-danger btn-sm ms-1">{{ 'admin.section.clear_all_images'|trans }}</button>
                        </form>
                    {% endif %}
                    <form method="post" action="{{ path('section_delete', { id: section.id }) }}" class="d-inline" data-confirm="{{ 'admin.section.confirm_delete_section'|trans|e('html_attr') }}" onsubmit="return confirm(this.getAttribute('data-confirm'));">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_section_' ~ section.id) }}">
                        <button type="submit" class="btn btn-outline-danger btn-sm ms-1">{{ 'form.label.delete'|trans }}</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9">{{ 'Aucune section trouvée pour cette page.' }}</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
