{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'admin.media_upload.title'|trans }}{% endblock %}

{% block importmap %}
    {{ importmap(['app', 'admin_media_upload']) }}
{% endblock %}

{% block stylesheets %}
<style>
/* Bloc Uppy sous le tableau : peu d’espace entre le tableau et le titre / zone « Déposez… » */
.admin-media-uppy-after-table {
    margin-top: 0.15rem;
}
.admin-media-uppy-after-table > h2.h6 {
    margin-bottom: 0.35rem;
}
.admin-media-uppy-after-table > .vstack {
    margin-bottom: 0.4rem !important;
}
.admin-media-uppy-wrap .uppy-Dashboard-inner {
    padding-top: 0.2rem;
    padding-bottom: 0.2rem;
}
.admin-media-uppy-wrap .uppy-Dashboard-innerWrap {
    padding-top: 0.25rem;
}
.admin-media-uppy-wrap .uppy-Dashboard-AddFiles {
    margin-top: 0;
    padding-top: 0.15rem;
    padding-bottom: 0.25rem;
    overflow: visible;
}
/* Libellés FR plus longs : retour à la ligne autorisé, pas de masquage horizontal (sinon le 2e lien dossier disparaît) */
.admin-media-uppy-wrap .uppy-Dashboard-AddFiles-title {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    align-content: flex-start;
    gap: 0.22rem;
    row-gap: 0.15rem;
    white-space: normal;
    overflow-x: visible;
    max-width: 100%;
    font-size: clamp(0.62rem, 0.45rem + 0.9vw, 0.78rem);
    line-height: 1.35;
    margin-bottom: 0.15rem;
    padding: 0 0.15rem 0 0.2rem;
}
.admin-media-uppy-wrap .uppy-Dashboard-browse.btn {
    flex-shrink: 0;
    white-space: nowrap;
    overflow: visible;
    vertical-align: middle;
    text-decoration: none !important;
}
/* Uppy applique des marges généreuses sur la note : on les resserre pour coller au panneau et au formulaire dessous */
.admin-media-uppy-wrap .uppy-Dashboard-note {
    margin: 0.1rem 0 0.05rem !important;
    padding: 0 !important;
    font-size: 0.75rem;
    line-height: 1.35;
}
.admin-media-uppy-wrap .uppy-Dashboard-files {
    margin-bottom: 0.15rem !important;
}
</style>
{% endblock %}

{% block content %}
    <h1 class="h4 mb-2">{{ 'admin.media_upload.title'|trans }}</h1>
    <p class="text-muted small mb-2">{{ 'admin.media_upload.help'|trans }}</p>
    <div class="alert alert-secondary small py-2 mb-3" role="status">
        {{ 'admin.media_upload.limits_explain'|trans({
            '%per_file%': (max_upload_bytes / 1048576)|number_format(1, '.', ' '),
            '%upload_ini%': php_ini_upload_max_filesize,
            '%post_ini%': php_ini_post_max_size,
            '%app_env%': app_upload_max_size
        })|raw }}
    </div>

    {% if app.request.query.get('media_upload_success') %}
        <div class="alert alert-success alert-dismissible fade show mb-3" role="status">
            {{ 'admin.media_upload.alert_upload_after_refresh'|trans }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ 'admin.media_upload.close_alert'|trans }}"></button>
        </div>
        <script>
            (function () {
                const u = new URL(window.location.href);
                if (u.searchParams.has('media_upload_success')) {
                    u.searchParams.delete('media_upload_success');
                    const q = u.searchParams.toString();
                    window.history.replaceState(null, '', u.pathname + (q ? '?' + q : '') + u.hash);
                }
            })();
        </script>
    {% endif %}

    <div id="admin-media-upload-banner" class="mb-0"></div>

    {% if not upload_dir_exists %}
        <div class="alert alert-warning">{{ 'admin.media_upload.dir_warning'|trans }}</div>
    {% endif %}

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item">
                <a href="{{ path('admin_media_upload_index', {_locale: app.request.locale}) }}">{{ 'admin.media_upload.root'|trans }}</a>
            </li>
            {% if current_path %}
                {% set acc = '' %}
                {% for part in current_path|split('/') %}
                    {% set acc = acc ? acc ~ '/' ~ part : part %}
                    <li class="breadcrumb-item{% if loop.last %} active{% endif %}"{% if loop.last %} aria-current="page"{% endif %}>
                        {% if not loop.last %}
                            <a href="{{ path('admin_media_upload_index', {_locale: app.request.locale, path: acc}) }}">{{ part }}</a>
                        {% else %}
                            {{ part }}
                        {% endif %}
                    </li>
                {% endfor %}
            {% endif %}
        </ol>
    </nav>

    {% if upload_dir_exists %}
        <form method="post" action="{{ path('admin_media_upload_mkdir', {_locale: app.request.locale}) }}" class="row g-2 align-items-end mb-2">
            <input type="hidden" name="_token" value="{{ csrf_token('media_upload') }}">
            <input type="hidden" name="parent" value="{{ current_path }}">
            <div class="col-md-4">
                <label for="new-folder-name" class="form-label small mb-0">{{ 'admin.media_upload.new_folder'|trans }}</label>
                <input class="form-control form-control-sm" id="new-folder-name" name="name" required maxlength="120" placeholder="{{ 'admin.media_upload.new_folder_placeholder'|trans }}">
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary">{{ 'admin.media_upload.mkdir_submit'|trans }}</button>
            </div>
        </form>

        <div class="table-responsive mb-1">
            <table class="table table-sm table-striped align-middle">
                <thead>
                    <tr>
                        <th scope="col" class="text-center" style="width: 4.5rem">{{ 'admin.media_upload.col_preview'|trans }}</th>
                        <th scope="col">{{ 'admin.media_upload.col_name'|trans }}</th>
                        <th scope="col">{{ 'admin.media_upload.col_type'|trans }}</th>
                        <th scope="col">{{ 'admin.media_upload.col_size'|trans }}</th>
                        <th scope="col">{{ 'admin.media_upload.col_link'|trans }}</th>
                        <th scope="col" style="min-width: 10rem">{{ 'admin.media_upload.col_actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody id="admin-media-files-tbody">
                    {% for d in directories %}
                        <tr>
                            <td class="text-center text-warning align-middle"><i class="fa-solid fa-folder fa-lg" title="{{ 'admin.media_upload.type_folder'|trans }}"></i></td>
                            <td class="align-middle">
                                <a href="{{ path('admin_media_upload_index', {_locale: app.request.locale, path: d.path}) }}" class="fw-medium">{{ d.name }}</a>
                            </td>
                            <td class="align-middle">{{ 'admin.media_upload.type_folder'|trans }}</td>
                            <td class="align-middle">—</td>
                            <td class="align-middle">—</td>
                            <td class="align-middle">
                                <div class="d-flex flex-column flex-xl-row gap-2 align-items-stretch">
                                    <form method="post" action="{{ path('admin_media_upload_rename_folder', {_locale: app.request.locale}) }}" class="d-flex flex-grow-1 gap-1 align-items-center">
                                        <input type="hidden" name="_token" value="{{ csrf_token('media_upload') }}">
                                        <input type="hidden" name="old_path" value="{{ d.path }}">
                                        <input type="hidden" name="browse_path" value="{{ current_path }}">
                                        <input type="text" name="new_name" value="{{ d.name }}" required maxlength="120" class="form-control form-control-sm flex-grow-1" aria-label="{{ 'admin.media_upload.rename_folder'|trans }}">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary text-nowrap">{{ 'admin.media_upload.rename_submit'|trans }}</button>
                                    </form>
                                    <form method="post" action="{{ path('admin_media_upload_delete_folder', {_locale: app.request.locale}) }}" class="flex-shrink-0" data-confirm="{{ 'admin.media_upload.confirm_delete_folder'|trans({'%name%': d.name})|e('html_attr') }}" onsubmit="return confirm(this.getAttribute('data-confirm'));">
                                        <input type="hidden" name="_token" value="{{ csrf_token('media_upload') }}">
                                        <input type="hidden" name="path" value="{{ d.path }}">
                                        <input type="hidden" name="browse_path" value="{{ current_path }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger text-nowrap">{{ 'admin.media_upload.delete_folder'|trans }}</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    {% for f in files %}
                        <tr>
                            <td class="text-center align-middle p-1">
                                {% if f.has_thumb %}
                                    <a href="{{ app.request.basePath ~ '/' ~ web_base ~ '/' ~ f.path }}" target="_blank" rel="noopener" class="d-inline-block border rounded overflow-hidden bg-light" style="width: 3rem; height: 3rem;">
                                        <img src="{{ app.request.basePath ~ '/' ~ web_base ~ '/' ~ f.path }}" alt="" width="48" height="48" loading="lazy" decoding="async" class="w-100 h-100" style="object-fit: cover;">
                                    </a>
                                {% else %}
                                    <span class="text-secondary"><i class="fa-regular fa-file fa-lg"></i></span>
                                {% endif %}
                            </td>
                            <td class="align-middle">{{ f.name }}</td>
                            <td class="align-middle">{{ 'admin.media_upload.type_file'|trans }}</td>
                            <td class="align-middle">{% if f.size < 1024 %}{{ f.size }} o{% else %}{{ (f.size / 1024)|round(1) }} Ko{% endif %}</td>
                            <td class="align-middle">
                                <a href="{{ app.request.basePath ~ '/' ~ web_base ~ '/' ~ f.path }}" target="_blank" rel="noopener">{{ 'admin.media_upload.open_file'|trans }}</a>
                            </td>
                            <td class="align-middle">
                                <form method="post" action="{{ path('admin_media_upload_delete_file', {_locale: app.request.locale}) }}" class="d-inline" data-confirm="{{ ('admin.media_upload.confirm_delete_file'|trans)|replace({'__NAME__': f.name})|e('html_attr') }}" onsubmit="return confirm(this.getAttribute('data-confirm'));">
                                    <input type="hidden" name="_token" value="{{ csrf_token('media_upload') }}">
                                    <input type="hidden" name="path" value="{{ f.path }}">
                                    <input type="hidden" name="browse_path" value="{{ current_path }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger text-nowrap">{{ 'admin.media_upload.delete_file'|trans }}</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                    {% if directories is empty and files is empty %}
                        <tr id="admin-media-empty-row">
                            <td colspan="6" class="text-muted">{{ 'admin.media_upload.empty_dir'|trans }}</td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    {% endif %}

    <div class="admin-media-uppy-wrap mb-3{% if upload_dir_exists %} admin-media-uppy-after-table{% endif %}">
        <h2 class="h6 mb-1">{{ 'admin.media_upload.uppy_section'|trans }}</h2>
        {% set path_label = current_path ? current_path : ('admin.media_upload.root'|trans) %}
        <div class="vstack gap-1 small text-muted lh-sm mb-1">
            <p class="mb-0">{{ 'admin.media_upload.uppy_hint'|trans({'%path%': path_label}) }}</p>
            <p class="mb-0">{{ 'admin.media_upload.uppy_perf_hint'|trans }}</p>
        </div>

        <div
            id="admin-media-upload"
            class="mt-0 pt-0"
            data-admin-locale="{{ app.request.locale }}"
            data-upload-url="{{ path('admin_media_upload_api', {_locale: app.request.locale}) }}"
            data-csrf-token="{{ csrf_token('media_upload') }}"
            data-max-file-size="{{ max_upload_bytes }}"
            data-allowed-file-types="{{ allowed_mime_types|json_encode|e('html_attr') }}"
            data-reject-file-msg="{{ 'admin.media_upload.file_type_rejected'|trans|e('html_attr') }}"
            data-current-path="{{ current_path|e('html_attr') }}"
            {% if upload_dir_exists %}
            data-request-base-path="{{ app.request.basePath|e('html_attr') }}"
            data-label-open-file="{{ 'admin.media_upload.open_file'|trans|e('html_attr') }}"
            data-label-type-file="{{ 'admin.media_upload.type_file'|trans|e('html_attr') }}"
            data-add-more-hint="{{ 'admin.media_upload.uppy_add_more_hint'|trans|e('html_attr') }}"
            data-delete-file-url="{{ path('admin_media_upload_delete_file', {_locale: app.request.locale})|e('html_attr') }}"
            data-label-delete-file="{{ 'admin.media_upload.delete_file'|trans|e('html_attr') }}"
            data-confirm-delete-file="{{ 'admin.media_upload.confirm_delete_file'|trans|e('html_attr') }}"
            data-msg-upload-files-success="{{ 'admin.media_upload.alert_upload_files_done'|trans|e('html_attr') }}"
            data-msg-close-alert="{{ 'admin.media_upload.close_alert'|trans|e('html_attr') }}"
            {% endif %}
        >
            <div data-uppy-dashboard-mount class="w-100"></div>
        </div>
    </div>
{% endblock %}
