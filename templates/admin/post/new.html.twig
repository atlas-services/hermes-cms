{% extends '/admin/base.html.twig' %}

{% block title %}New Post{% endblock %}

{% block content %}
    {% set section = section|default(null) %}
    {% set menu = menu|default(null) %}
    {% set isFooterSection = isFooterSection|default(false) %}
    {% set isTopbarSection = isTopbarSection|default(false) %}

    <h1>{{ 'form.label.create'|trans() }}</h1>

    {% if isTopbarSection or (section and section.topbarSection) %}
        <div class="alert alert-info">
            {{ 'admin.topbar_sections.post_create_context'|trans }}
            {% if section %}
                <br>
                {{ 'form.label.section_position'|trans({'%position%': section.position}) }}
            {% endif %}
        </div>
    {% elseif isFooterSection or (section and section.footerSection) %}
        <div class="alert alert-info">
            {{ 'admin.footer_sections.post_create_context'|trans }}
            {% if section %}
                <br>
                {{ 'form.label.section_position'|trans({'%position%': section.position}) }}
            {% endif %}
        </div>
    {% elseif menu %}
        <div class="alert alert-info">
            {{ 'admin.post.create_in_menu'|trans }} <strong>{{ menu.name }}</strong>
        </div>
    {% endif %}

    {% if section %}
        <div class="alert alert-secondary">
            {{ 'form.label.post_section_type_summary'|trans({
                '%summary%': section.template ? (section.template.summary|default('')) : ''
            }) }}
        </div>
    {% endif %}

    {{ include('admin/post/_form.html.twig', {
        button_label: 'form.label.create'|trans(),
        menu: menu|default(null),
        section: section|default(null),
        isFooterSection: isFooterSection,
        isTopbarSection: isTopbarSection,
        post_template_field_toggle: post_template_field_toggle|default(false),
        post_template_types: post_template_types|default({}),
        liste_import_section: liste_import_section|default(null),
    }) }}

    {% if post_template_field_toggle is defined and post_template_field_toggle %}
        <script type="application/json" id="post-template-meta-json">{{ post_template_types|default({})|json_encode(7)|raw }}</script>
        <script>
        (function () {
            var metaEl = document.getElementById('post-template-meta-json');
            if (!metaEl) return;
            var meta;
            try {
                meta = JSON.parse(metaEl.textContent || '{}');
            } catch (e) {
                return;
            }
            var form = document.querySelector('form[name="post"]');
            if (!form) return;

            var templateSelect = form.querySelector('select[name="post[template]"]');
            var wrapImage = form.querySelector('.js-post-field-image');
            var wrapListeImport = form.querySelector('.js-post-field-liste-import');
            var wrapContent = form.querySelector('.js-post-field-content');
            var wrapSaveImport = form.querySelector('.js-post-wrap-save-import');
            if ((!wrapImage && !wrapListeImport) || !wrapContent) return;

            var templates = (meta.templates || {});

            function resolveType() {
                var tid = templateSelect && templateSelect.value;
                if (tid && Object.prototype.hasOwnProperty.call(templates, tid)) {
                    return templates[tid] || '';
                }
                return '';
            }

            function apply() {
                var t = resolveType();
                var isListe = t === 'liste';
                var isLibre = t === 'libre';
                var isFormulaire = t === 'formulaire';

                if (isListe) {
                    if (wrapListeImport) {
                        wrapListeImport.classList.remove('d-none');
                    }
                    if (wrapImage) {
                        wrapImage.classList.add('d-none');
                    }
                    wrapContent.classList.add('d-none');
                } else if (isLibre) {
                    wrapContent.classList.remove('d-none');
                    if (wrapImage) {
                        wrapImage.classList.add('d-none');
                    }
                    if (wrapListeImport) {
                        wrapListeImport.classList.add('d-none');
                    }
                } else if (isFormulaire) {
                    wrapContent.classList.add('d-none');
                    if (wrapImage) {
                        wrapImage.classList.add('d-none');
                    }
                    if (wrapListeImport) {
                        wrapListeImport.classList.add('d-none');
                    }
                } else {
                    if (wrapImage) {
                        wrapImage.classList.remove('d-none');
                    }
                    if (wrapListeImport) {
                        wrapListeImport.classList.add('d-none');
                    }
                    wrapContent.classList.remove('d-none');
                }
                if (wrapSaveImport) {
                    if (isListe) {
                        wrapSaveImport.classList.remove('d-none');
                    } else {
                        wrapSaveImport.classList.add('d-none');
                    }
                }
            }

            form.addEventListener('change', function (e) {
                var n = e.target && e.target.name;
                if (n === 'post[template]') {
                    apply();
                }
            });

            apply();
        })();
        </script>
    {% endif %}
{% endblock %}
