{% extends '/admin/base.html.twig' %}

{% block title %}New Post{% endblock %}

{% block content %}
    <h1>{{ 'form.label.create'|trans() }}</h1>

    {% if menu is defined %}
        <div class="alert alert-info">
            {{ 'Ajout d’un post dans le menu :' }} <strong>{{ menu.name }}</strong>
            {% if section is defined %}
                <br>
                {{ 'Section :' }} <strong>{{ section.position }}</strong>
            {% endif %}
        </div>
    {% endif %}

    {% if section is defined %}
        <div class="alert alert-secondary">
            {{ 'form.label.post_section_type_summary'|trans({
                '%summary%': section.template ? (section.template.summary|default('')) : ''
            }) }}
        </div>
        {% if section.template and section.template.type == 'liste' %}
            <div class="mb-3">
                <a class="btn btn-outline-primary btn-sm" href="{{ path('post_bulk_import_media_images', { id: section.id }) }}">
                    {{ 'admin.post_bulk.add_images'|trans }}
                </a>
            </div>
        {% endif %}
    {% endif %}

    {{ include('admin/post/_form.html.twig', {
        'button_label': 'form.label.create'|trans(),
        'post_template_field_toggle': post_template_field_toggle|default(false),
        'post_template_types': post_template_types|default({}),
    }) }}

    {% if post_template_field_toggle is defined and post_template_field_toggle %}
        <script type="application/json" id="post-template-meta-json">{{ post_template_types|default({})|json_encode(7)|raw }}</script>
        <script>
        (function () {
            var metaEl = document.getElementById('post-template-meta-json');
            if (!metaEl) return;
            var meta;
            try {
                meta = JSON.parse(metaEl.textContent || '{}');
            } catch (e) {
                return;
            }
            var form = document.querySelector('form[name="post"]');
            if (!form) return;

            var templateSelect = form.querySelector('select[name="post[template]"]');
            var wrapImage = form.querySelector('.js-post-field-image');
            var wrapContent = form.querySelector('.js-post-field-content');
            var wrapSaveImport = form.querySelector('.js-post-wrap-save-import');
            if (!wrapImage || !wrapContent) return;

            var templates = (meta.templates || {});

            function resolveType() {
                var tid = templateSelect && templateSelect.value;
                if (tid && Object.prototype.hasOwnProperty.call(templates, tid)) {
                    return templates[tid] || '';
                }
                return '';
            }

            function apply() {
                var t = resolveType();
                var isListe = t === 'liste';
                var isLibre = t === 'libre';

                if (isListe) {
                    wrapImage.classList.remove('d-none');
                    wrapContent.classList.add('d-none');
                } else if (isLibre) {
                    wrapContent.classList.remove('d-none');
                    wrapImage.classList.add('d-none');
                } else {
                    wrapImage.classList.remove('d-none');
                    wrapContent.classList.remove('d-none');
                }
                if (wrapSaveImport) {
                    if (isListe) {
                        wrapSaveImport.classList.remove('d-none');
                    } else {
                        wrapSaveImport.classList.add('d-none');
                    }
                }
            }

            form.addEventListener('change', function (e) {
                var n = e.target && e.target.name;
                if (n === 'post[template]') {
                    apply();
                }
            });

            apply();
        })();
        </script>
    {% endif %}

    {% if menu is defined %}
        <a class="btn btn-info my-3"
           href="{{ path('menu_edit', {'id': menu.id}) }}">
            {{ 'form.label.back_to_list'|trans() }}
        </a>
    {% endif %}
{% endblock %}
