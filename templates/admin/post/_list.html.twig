<table class="table">
    <thead>
        <tr>
            <th class="col-4">{{ 'form.label.active'|trans }}</th>
            <th class="col-4">{{ 'form.label.menu'|trans }} / {{ 'form.label.section'|trans }}</th>
            <th class="col-3">{{ 'form.label.position'|trans }}</th>
            <th>{{ 'form.label.actions'|trans }}</th>
        </tr>
    </thead>

    <tbody 
        data-controller="move-item"
        data-type="post"
        data-locale="{{ app.request.locale }}"
    >
    {% for post in posts %}
        <tr class="list-items align-middle"
            data-move-item-target="item"
            data-item-id="{{ post.id }}"
        >
            <td>
                <div class="form-check form-switch my-0">
                    <input
                        data-controller="active-item"
                        type="checkbox"
                        class="form-check-input bg-success"
                        data-action="click->active-item#switch"
                        data-id="{{ post.id }}"
                        data-type="post"
                        {{ post.active ? 'checked' : '' }}
                    >
                    <label>{{ post.name }}</label>
                </div>
            </td>

            <td>
                {% if post.section is defined and post.section is not null and post.section.menu is not null %}
                    {% set menu = post.section.menu %}
                    <div>
                        <label class="custom-control-label">
                            {{ menu.parent ? menu.parent.name ~ '/' : '' }}{{ menu.name }}
                        </label>
                        <div><small class="text-muted">Section {{ post.section.position }} - {{ post.section.template ? post.section.template.name : '—' }}</small></div>
                    </div>
                {% else %}
                    <span>N/A</span>
                {% endif %}
            </td>

            <td>
                <button class="btn btn-outline-success"
                        data-action="click->move-item#moveUp">↑</button>

                <button class="btn btn-outline-success"
                        data-action="click->move-item#moveDown">↓</button>
            </td>

            <td>
                <a class="btn btn-outline-success"
                   href="{{ path('post_edit', {id: post.id}) }}">
                    {{ ux_icon('fa:edit', {height: '16px'}) }}
                </a>

                <form method="post" action="{{ path('post_delete', {id: post.id}) }}" class="d-inline-block ms-2" onsubmit="return confirm('{{ 'global.confirm_delete'|trans() }}');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_' ~ post.id) }}">
                    <button type="submit" class="btn btn-outline-danger">{{ ux_icon('fa:trash', {height: '16px'}) }}</button>
                </form>
            </td>
        </tr>
    {% else %}
        <tr>
            <td colspan="3">{{ 'form.label.no_record'|trans }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
