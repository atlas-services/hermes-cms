{% form_theme form with ['form/vich_image_widget.html.twig'] %}
{% set form_attr = {} %}
{% if form.imageFile is defined %}
    {% set form_attr = form_attr|merge({ enctype: 'multipart/form-data' }) %}
{% endif %}
{{ form_start(form, { attr: form_attr }) }}

{# ------------------------- #}
{# NAME #}
{# ------------------------- #}
<div class="mb-3">
    {{ form_label(form.name) }}
    {{ form_widget(form.name, { attr: { class: 'form-control' } }) }}
    {{ form_errors(form.name) }}
</div>

{# ------------------------- #}
{# TEMPLATE (création menu uniquement) #}
{# ------------------------- #}
{% if form.template is defined %}
    <div class="mb-3">
        {{ form_label(form.template) }}
        {{ form_widget(form.template, { attr: { class: 'form-select' } }) }}
        {{ form_errors(form.template) }}
        <small class="text-muted">
            {{ 'form.label.post_template_help'|trans }}
        </small>
    </div>
{% endif %}

{# ------------------------- #}
{# IMAGE (templates type « liste » ; masqué en JS en création menu si type libre) #}
{# ------------------------- #}
{% if form.imageFile is defined %}
    <div class="mb-3 js-post-field-image">
        {{ form_label(form.imageFile) }}
        {{ form_widget(form.imageFile) }}
        {{ form_errors(form.imageFile) }}
    </div>
{% endif %}

{# ------------------------- #}
{# CONTENT (CKEditor — templates type « libre ») #}
{# ------------------------- #}
{% if form.content is defined %}
    <div class="mb-3 js-post-field-content">
        {{ form_label(form.content) }}
        {{ form_widget(form.content) }}
        {{ form_errors(form.content) }}
    </div>
{% endif %}

{{ form_widget(form._token) }}

<div class="mb-3 d-flex flex-wrap align-items-center gap-2">
    {{ form_widget(form.save, { attr: { class: 'btn btn-success' } }) }}
    {% if form.saveAndImportImages is defined %}
        <span class="js-post-wrap-save-import d-none">{{ form_widget(form.saveAndImportImages) }}</span>
    {% endif %}
</div>

{{ form_end(form, { render_rest: false }) }}
