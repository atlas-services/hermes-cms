{# Boutons post (création / édition) — inclus en haut et en bas du formulaire #}
{% set save_label = button_label|default('form.label.save'|trans) %}
<div class="admin-post-form-toolbar d-flex flex-wrap gap-2 align-items-center {{ toolbar_class|default('mb-3') }}">
    <button type="submit" form="admin-post-form" name="post[save]" class="btn btn-success">
        {{ save_label }}
    </button>
    {% if render_save_import_buttons|default(true) and form.saveAndImportImages is defined %}
        <span class="js-post-wrap-save-import{{ post_template_field_toggle|default(false) ? ' d-none' : '' }}">
            {% set add_images_label = form.saveAndImportImages.vars.label|trans(form.saveAndImportImages.vars.label_translation_parameters, form.saveAndImportImages.vars.translation_domain) %}
            {{ include('admin/_btn_add_icon.html.twig', {
                label: add_images_label,
                btn_class: 'btn btn-outline-primary',
                form: 'admin-post-form',
                name: 'post[saveAndImportImages]',
            }) }}
        </span>
    {% endif %}

    {% if post and post.section %}
        <a class="btn btn-success" href="{{ path('post_new_section', { id: post.section.id }) }}">
            {{ 'global.continue'|trans }}
        </a>
    {% endif %}

    {% if post %}
        {% if post.section and post.section.topbarSection %}
            <a class="btn btn-info" href="{{ path('admin_topbar_sections_index', { _locale: app.request.locale }) }}">
                {{ 'form.label.back_to_list'|trans }}
            </a>
        {% elseif post.section and post.section.footerSection %}
            <a class="btn btn-info" href="{{ path('admin_footer_sections_index', { _locale: app.request.locale }) }}">
                {{ 'form.label.back_to_list'|trans }}
            </a>
        {% elseif menu %}
            <a class="btn btn-info" href="{{ path('post_index', { page: menu.id, _locale: app.request.locale }) }}">
                {{ 'form.label.back_to_list'|trans }}
            </a>
        {% else %}
            <a class="btn btn-info" href="{{ path('post_index', { _locale: app.request.locale }) }}">
                {{ 'form.label.back_to_list'|trans }}
            </a>
        {% endif %}
        <button type="submit"
                form="admin-post-delete-form"
                class="btn btn-outline-danger"
                title="{{ 'form.label.delete'|trans }}"
                onclick="return confirm('{{ 'global.confirm_delete'|trans|e('js') }}');">
            {{ ux_icon('fa:trash', {height: '16px'}) }}
            <span class="visually-hidden">{{ 'form.label.delete'|trans }}</span>
        </button>
        {% if post %}
            <a class="btn btn-outline-secondary"
               href="{{ path('admin_content_transfer_post', { id: post.id }) }}"
               title="{{ 'admin.content_transfer.title'|trans }}">
                {{ ux_icon('fa:copy', {height: '16px'}) }}
                <span class="visually-hidden">{{ 'admin.content_transfer.title'|trans }}</span>
            </a>
        {% endif %}
    {% elseif isTopbarSection|default(false) or (section and section.topbarSection) %}
        <a class="btn btn-info" href="{{ path('admin_topbar_sections_index', { _locale: app.request.locale }) }}">
            {{ 'form.label.back_to_list'|trans }}
        </a>
    {% elseif isFooterSection|default(false) or (section and section.footerSection) %}
        <a class="btn btn-info" href="{{ path('admin_footer_sections_index', { _locale: app.request.locale }) }}">
            {{ 'form.label.back_to_list'|trans }}
        </a>
    {% elseif menu %}
        <a class="btn btn-info" href="{{ path('post_index', { page: menu.id, _locale: app.request.locale }) }}">
            {{ 'form.label.back_to_list'|trans }}
        </a>
    {% endif %}
</div>
