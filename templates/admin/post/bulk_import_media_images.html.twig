{% extends '/admin/base.html.twig' %}

{% block title %}{{ 'admin.post_bulk.title'|trans }}{% endblock %}

{% block importmap %}
    {{ importmap(['app', 'admin_media_upload']) }}
{% endblock %}

{% block stylesheets %}
<style>
.admin-media-uppy-wrap .uppy-Dashboard-inner { padding-top: 0.2rem; padding-bottom: 0.2rem; }
.admin-media-uppy-wrap .uppy-Dashboard-AddFiles-title {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.22rem;
    white-space: normal; max-width: 100%;
    font-size: clamp(0.62rem, 0.45rem + 0.9vw, 0.78rem); line-height: 1.35;
}
.admin-media-uppy-wrap .uppy-Dashboard-browse.btn { flex-shrink: 0; white-space: nowrap; }
</style>
{% endblock %}

{% block content %}
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h1 class="h3 mb-0">{{ 'admin.post_bulk.title'|trans }}</h1>
        <a class="btn btn-outline-secondary btn-sm" href="{{ path('post_index', { _locale: app.request.locale, page: page_menu_id }) }}">
            {{ 'admin.post_bulk.back_pages'|trans }}
        </a>
    </div>

    <p class="text-muted">{{ 'admin.post_bulk.help'|trans }}</p>

    {% if upload_dir_readable is defined and not upload_dir_readable %}
        <div class="alert alert-warning">{{ 'admin.post_bulk.upload_dir_missing'|trans }}</div>
    {% endif %}

    {% if app.request.query.get('media_upload_success') %}
        <div class="alert alert-success alert-dismissible fade show mb-3" role="status">
            {{ 'admin.media_upload.alert_upload_after_refresh'|trans }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ 'admin.media_upload.close_alert'|trans }}"></button>
        </div>
        <script>
            (function () {
                const u = new URL(window.location.href);
                if (u.searchParams.has('media_upload_success')) {
                    u.searchParams.delete('media_upload_success');
                    const q = u.searchParams.toString();
                    window.history.replaceState(null, '', u.pathname + (q ? '?' + q : '') + u.hash);
                }
            })();
        </script>
    {% endif %}

    <div class="alert alert-light border mb-3 small">
        <strong>{{ 'global.page'|trans }}</strong> : {{ menu.name }}
        — <strong>{{ 'form.label.section'|trans }}</strong> #{{ section.position }}
        {% if section.template %}({{ section.template.name }}){% endif %}
    </div>

    <p class="small text-muted mb-1">{{ 'admin.post_bulk.current_folder'|trans }} : <code>{{ current_path ? current_path : ('admin.media_upload.root'|trans) }}</code></p>

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item">
                <a href="{{ path('post_bulk_import_media_images', { _locale: app.request.locale, id: section.id }) }}">{{ 'admin.media_upload.root'|trans }}</a>
            </li>
            {% if current_path %}
                {% set acc = '' %}
                {% for part in current_path|split('/') %}
                    {% set acc = acc ? acc ~ '/' ~ part : part %}
                    <li class="breadcrumb-item{% if loop.last %} active{% endif %}"{% if loop.last %} aria-current="page"{% endif %}>
                        {% if not loop.last %}
                            <a href="{{ path('post_bulk_import_media_images', { _locale: app.request.locale, id: section.id, path: acc }) }}">{{ part }}</a>
                        {% else %}
                            {{ part }}
                        {% endif %}
                    </li>
                {% endfor %}
            {% endif %}
        </ol>
    </nav>

    {% if current_path %}
        <p class="mb-2">
            <a class="btn btn-sm btn-outline-secondary" href="{{ path('post_bulk_import_media_images', { _locale: app.request.locale, id: section.id, path: parent_path }) }}">
                {{ 'admin.post_bulk.back_parent'|trans }}
            </a>
        </p>
    {% endif %}

    {% if upload_enabled|default(false) %}
        {{ include('admin/media_upload/_uppy_panel.html.twig', {
            current_path: current_path,
            max_upload_bytes: max_upload_bytes,
            allowed_mime_types: allowed_mime_types,
            upload_enabled: true,
            reload_on_success: true,
            uppy_title: 'admin.post_bulk.upload_section'|trans,
        }) }}
    {% endif %}

    <h2 class="h6">{{ 'admin.post_bulk.subfolders'|trans }}</h2>
    {% if directories is empty %}
        <p class="text-muted small">{{ 'admin.post_bulk.empty_children'|trans }}</p>
    {% else %}
        <ul class="list-unstyled mb-4">
            {% for d in directories %}
                <li class="mb-1">
                    <a href="{{ path('post_bulk_import_media_images', { _locale: app.request.locale, id: section.id, path: d.path }) }}" class="fw-medium">
                        <i class="fa-solid fa-folder text-warning me-1"></i>{{ d.name }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    <h2 class="h6">{{ 'admin.post_bulk.images_here'|trans }}</h2>
    {% if image_files is empty %}
        <p class="text-muted">{{ 'admin.post_bulk.no_images_here'|trans }}</p>
    {% else %}
        <ul class="list-group mb-3">
            {% for rel in image_files %}
                <li class="list-group-item d-flex align-items-center gap-2">
                    <img src="{{ app.request.basePath ~ '/' ~ web_base ~ '/' ~ rel }}" alt="" width="40" height="40" class="rounded border" style="object-fit: cover;" loading="lazy">
                    <span>{{ rel|split('/')|last }}</span>
                </li>
            {% endfor %}
        </ul>

        <form method="post" action="{{ path('post_bulk_import_media_images', { _locale: app.request.locale, id: section.id }) }}" class="border rounded p-3 bg-light" onsubmit="return confirm({{ 'admin.post_bulk.confirm_import'|trans({'%count%': image_files|length})|json_encode|raw }});">
            <input type="hidden" name="_token" value="{{ csrf_token('post_bulk_import_images_' ~ section.id) }}">
            <input type="hidden" name="media_path" value="{{ current_path }}">
            <button type="submit" class="btn btn-primary">{{ 'admin.post_bulk.import_button'|trans }}</button>
            <span class="text-muted small ms-2">{{ image_files|length }} image(s)</span>
        </form>
    {% endif %}
{% endblock %}
