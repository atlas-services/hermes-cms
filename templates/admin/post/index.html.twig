{% extends '/admin/base.html.twig' %}

{% block title %}{{ 'global.list_pages'|trans() }}{% endblock %}

{% block content %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>{{ 'global.list_pages'|trans() }}</h1>
            <p class="text-muted">{{ 'Affichage des sections et des posts de la page sélectionnée.' }}</p>
        </div>
        <a class="btn btn-success" href="{{ path('menu_index') }}">{{ 'global.list_menus'|trans() }}</a>
    </div>

    {% if pageChoices is empty %}
        <div class="alert alert-warning">
            {{ 'Aucune page disponible.' }}
        </div>
    {% else %}
        <form method="get" class="row g-3 mb-4">
            <div class="col-md-6 col-lg-5">
                <label for="page-select" class="form-label">{{ 'global.page'|trans() }}</label>
                <select id="page-select" name="page" class="form-select" onchange="this.form.submit()">
                    {% for choice in pageChoices %}
                        <option value="{{ choice.menu.id }}" {{ selectedPage is defined and choice.menu.id == selectedPage.id ? 'selected' : '' }}>
                            {{ choice.label }}
                        </option>
                    {% endfor %}
                </select>
            </div>
        </form>

        {% if selectedPage is not null %}
            <div class="mb-3">
                <h2>{{ selectedPage.name }}</h2>
                <p class="text-muted">
                    {{ selectedPage.sections|length }} {{ selectedPage.sections|length > 1 ? 'sections' : 'section' }}
                </p>
            </div>

            <div class="mb-3">
                <a class="btn btn-success" href="{{ path('post_new', {id: selectedPage.id}) }}">{{ 'Ajouter un post' }}</a>
            </div>

            {{ include('admin/section/_list.html.twig', {
                sections: selectedPage.sections|filter(section => not section.footerSection),
                sectionModaleChoices: sectionModaleChoices|default([]),
                sectionListeTemplateChoices: sectionListeTemplateChoices|default({}),
            }) }}
        {% endif %}
    {% endif %}
{% endblock %}
