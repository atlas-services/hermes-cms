{% extends '/admin/base.html.twig' %}

{% block title %}{{ 'form.label.edit'|trans() }}{% endblock %}

{% block content %}
    <h1>{{ 'form.label.edit'|trans() }}</h1>

    {{ include('admin/post/_form.html.twig', { 'button_label': 'form.label.update'|trans() }) }}

    <div class="mt-3 d-flex flex-wrap gap-2 align-items-center">
        {% if post.section %}
            <a class="btn btn-success" href="{{ path('post_new_section', { id: post.section.id }) }}">
                {{ 'global.continue'|trans }}
            </a>
        {% endif %}
        <a class="btn btn-info" href="{{ path('post_index') }}">
            {{ 'form.label.back_to_list'|trans() }}
        </a>

        <form method="post" action="{{ path('post_delete', {id: post.id}) }}" class="d-inline-block" onsubmit="return confirm('{{ 'global.confirm_delete'|trans() }}');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_' ~ post.id) }}">
            <button type="submit" class="btn btn-danger">
                {{ 'form.label.delete'|trans() }}
            </button>
        </form>
    </div>
{% endblock %}
