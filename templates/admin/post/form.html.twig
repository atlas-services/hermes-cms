{% extends '/admin/base.html.twig' %}

{% block title %}{{ 'form.label.edit'|trans() }}{% endblock %}

{% block content %}
    <h1>{{ 'form.label.edit'|trans() }}</h1>

    <form id="admin-post-delete-form" method="post" action="{{ path('post_delete', { id: post.id }) }}" class="d-none" tabindex="-1" aria-hidden="true">
        <input type="hidden" name="_token" value="{{ csrf_token('delete_' ~ post.id) }}">
    </form>

    {{ include('admin/post/_form.html.twig', {
        button_label: 'form.label.update'|trans(),
        post: post,
        section: post.section,
        isFooterSection: post.section ? post.section.footerSection : false,
        isTopbarSection: post.section ? post.section.topbarSection : false,
        liste_import_section: liste_import_section|default(null),
    }) }}
{% endblock %}
