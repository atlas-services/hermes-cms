{# Formulaire de suppression avec modale de confirmation (Hermes 2.2.7). #}
{% set modal_id = 'deleteModal' ~ (action|split('/')|last) %}

<button type="button"
        class="btn btn-danger btn-sm"
        data-bs-toggle="modal"
        data-bs-target="#{{ modal_id }}"
        title="{{ 'form.label.delete'|trans }}">
    {{ ux_icon('fa:trash', {height: '16px'}) }}
    <span class="visually-hidden">{{ 'form.label.delete'|trans }}</span>
</button>

<div class="modal fade" id="{{ modal_id }}" tabindex="-1" aria-labelledby="{{ modal_id }}Label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="{{ modal_id }}Label">{{ 'form.label.delete'|trans }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'global.close'|trans|default('Fermer') }}"></button>
            </div>
            <div class="modal-body">
                {% if confirm_message is defined and confirm_message %}
                    {{ confirm_message }}
                {% else %}
                    {{ 'global.confirm_delete_question'|trans }} {{ objet }}
                {% endif %}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    {{ 'global.unconfirm_delete'|trans|default('global.cancel'|trans|default('Annuler')) }}
                </button>
                <form method="post" action="{{ action }}" class="d-inline">
                    <input type="hidden" name="_token" value="{{ csrf_token_delete }}">
                    <button type="submit" class="btn btn-danger">{{ 'global.confirm_delete'|trans }}</button>
                </form>
            </div>
        </div>
    </div>
</div>
