{% extends '/admin/base.html.twig' %}

{% block title %}{{ 'config.label'|trans() }} — {{ 'global.show'|trans() }}{% endblock %}

{% block content %}
    <a class="btn btn-info my-3" href="{{ path('config_index', {'type': config.type}) }}">{{ 'form.label.back_to_list'|trans() }}</a>
    <h1 class="text-secondary">{{ 'global.show'|trans() }} {{ config.value }}</h1>

    <table class="table">
        <tbody>
            {% if is_granted('ROLE_SUPER_ADMIN') %}
            <tr>
                <th>{{ 'global.code'|trans() }}</th>
                <td>{{ config.code }}</td>
            </tr>
            {% endif %}
            <tr>
                <th>{{ 'global.value'|trans() }}</th>
                <td>{{ config.value }}</td>
            </tr>
        </tbody>
    </table>

    <a class="btn btn-info my-3" href="{{ path('config_index', {'type': config.type}) }}">{{ 'form.label.back_to_list'|trans() }}</a>

    <a class="btn btn-outline-success my-3" href="{{ path('config_edit', {'id': config.id}) }}">{{ 'form.label.edit'|trans() }}</a>
{% endblock %}
