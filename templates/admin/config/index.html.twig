{% extends '/admin/base.html.twig' %}

{% block title %}{{ 'global.list'|trans() }}{% endblock %}

{% block content %}
<div class="hermes-admin-config-page">
    <header class="mb-4">
        <h1 class="h3 text-secondary mb-0">{{ 'config.label'|trans() }}</h1>
    </header>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
        <tr>
        <th>{{ 'global.active'|trans() }}</th>
        <th>{{ 'config.type'|trans() }}</th>
        {% if is_granted('ROLE_SUPER_ADMIN') %}
            <th>{{ 'global.code'|trans() }}</th>
        {% endif %}
        <th>{{ 'global.summary'|trans() }}</th>
        <th>{{ 'global.value'|trans() }}</th>
        <th>{{ 'global.position'|trans() }}</th>
        <th>{{ 'global.image'|trans() }}</th>
        <th>{{ 'global.actions'|trans() }}</th>
        </tr>
        </thead>
        <tbody
            data-controller="move-item"
            data-type="config"
            data-locale="{{ app.request.locale }}"
        >
        {% for config in configs  %}
                <tr class="list-items align-middle" data-move-item-target="item" data-item-id="{{ config.id }}">
                    <td>
                        <form method="post" action="{{ path('config_toggle_active', {'id': config.id, _locale: app.request.locale}) }}" class="d-inline toggle-active-form" data-config-id="{{ config.id }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('toggle-active' ~ config.id) }}">
                            <button type="submit" class="btn btn-sm {{ config.active ? 'btn-success' : 'btn-secondary' }} toggle-active-btn" data-loading-text="{{ 'global.loading'|trans() }}">
                                <i class="fas {{ config.active ? 'fa-check' : 'fa-times' }}"></i>
                                {{ config.active ? 'global.active'|trans() : 'global.inactive'|trans() }}
                            </button>
                        </form>
                    </td>
                    <td>{{ config.type }}</td>
                        {% if is_granted('ROLE_SUPER_ADMIN') %}
                            <td>{{ config.code }}</td>
                        {% endif %}
                    <td>{{ config.summary }}</td>
                    <td>
                        {% if 'color' in config.code  %}
                            <span class="mt-0 mr-1" style="width:20px;height:10px;border:1px solid ;background-color:{{ config.value }}" >&nbsp; &nbsp; &nbsp; </span>
                        {% endif %}
                        {{ config.value }}{{ 'width' in config.code  ? '/12' : '' }}
                    </td>
                    <td>
                        <div class="d-flex gap-1">
                            <button type="button"
                                    class="btn btn-outline-success btn-sm"
                                    data-action="click->move-item#moveUp"
                                    aria-label="{{ 'form.label.move_up'|trans|default('Monter') }}">↑</button>
                            <button type="button"
                                    class="btn btn-outline-success btn-sm"
                                    data-action="click->move-item#moveDown"
                                    aria-label="{{ 'form.label.move_down'|trans|default('Descendre') }}">↓</button>
                        </div>
                    </td>
                    <td>
                        {% if vich_uploader_asset(config, 'imageFile') is not null %}
                            <img style="max-height: 100px;" src="{{ asset(vich_uploader_asset(config, 'imageFile')) }}" /></td>
                        {% endif %}
                    <td class="col-sm-2">
                        <a class="btn btn-success" href="{{ path('config_edit', {'id': config.id}) }}">{{'form.label.update'|trans()|raw }}</a>
                    </td>
                </tr>
        {% else %}
            <tr class="align-middle">
                <td colspan="5">{{ 'global.no_record'|trans()|raw }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const activeText = '{{ 'global.active'|trans()|escape('js') }}';
            const inactiveText = '{{ 'global.inactive'|trans()|escape('js') }}';
            const successTitle = '{{ 'global.success'|trans()|escape('js') }}';
            const errorTitle = '{{ 'global.error'|trans()|escape('js') }}';
            const successMessage = '{{ 'config.toggle_success'|trans()|escape('js') }}';
            const errorMessage = '{{ 'config.toggle_error'|trans()|escape('js') }}';

            document.querySelectorAll('.toggle-active-form').forEach(function (form) {
                if (form.dataset.toggleBound === '1') {
                    return;
                }

                form.dataset.toggleBound = '1';

                form.addEventListener('submit', async function (event) {
                    event.preventDefault();

                    const button = form.querySelector('.toggle-active-btn');
                    if (!button || button.disabled) {
                        return;
                    }

                    button.disabled = true;
                    button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> ' + button.dataset.loadingText;

                    try {
                        const response = await fetch(form.action, {
                            method: 'POST',
                            body: new FormData(form),
                            credentials: 'same-origin',
                            headers: {
                                'Accept': 'application/json',
                                'X-Requested-With': 'XMLHttpRequest',
                            },
                        });

                        const contentType = response.headers.get('content-type') || '';
                        if (!response.ok || !contentType.includes('application/json')) {
                            throw new Error('Invalid toggle response');
                        }

                        const data = await response.json();
                        if (!data.success) {
                            throw new Error(data.error || 'Unknown toggle error');
                        }

                        button.className = 'btn btn-sm ' + (data.active ? 'btn-success' : 'btn-secondary') + ' toggle-active-btn';
                        button.innerHTML = '<i class="fas ' + (data.active ? 'fa-check' : 'fa-times') + '"></i> ' + (data.active ? activeText : inactiveText);
                        showConfigToggleAlert('success', successTitle, successMessage, 3000);
                    } catch (error) {
                        console.error('Error:', error);
                        showConfigToggleAlert('danger', errorTitle, errorMessage, 5000);
                    } finally {
                        button.disabled = false;
                    }
                });
            });

            function showConfigToggleAlert(type, title, message, duration) {
                const alertDiv = document.createElement('div');
                alertDiv.className = 'alert alert-' + type + ' alert-dismissible fade show position-fixed';
                alertDiv.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
                alertDiv.innerHTML = `
                    <strong>${title}!</strong> ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;
                document.body.appendChild(alertDiv);

                setTimeout(() => {
                    if (alertDiv.parentNode) {
                        alertDiv.remove();
                    }
                }, duration);
            }
        });
    </script>
</div>
{% endblock %}
