{% extends '/admin/base.html.twig' %}

{% block title %}{{ 'global.list'|trans() }}{% endblock %}

{% block content %}
    <h1 class="text-secondary">{{ 'config.label'|trans() }}</h1>

    <table class="table">
        <thead>
        <th>{{ 'global.active'|trans() }}</th>
        <th>{{ 'config.type'|trans() }}</th>
        {% if is_granted('ROLE_SUPER_ADMIN') %}
            <th>{{ 'global.code'|trans() }}</th>
        {% endif %}
        <th>{{ 'global.summary'|trans() }}</th>
        <th>{{ 'global.value'|trans() }}</th>
        <th>{{ 'global.position'|trans() }}</th>
        <th>{{ 'global.image'|trans() }}</th>
        <th>{{ 'global.actions'|trans() }}</th>
        </tr>
        </thead>
        <tbody>
        {% for config in configs  %}
                <tr class="align-middle">
                    <td>
                        <form method="post" action="{{ path('config_toggle_active', {'id': config.id}) }}" class="d-inline toggle-active-form" data-config-id="{{ config.id }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('toggle-active' ~ config.id) }}">
                            <button type="submit" class="btn btn-sm {{ config.active ? 'btn-success' : 'btn-secondary' }} toggle-active-btn" data-loading-text="{{ 'global.loading'|trans() }}">
                                <i class="fas {{ config.active ? 'fa-check' : 'fa-times' }}"></i>
                                {{ config.active ? 'global.active'|trans() : 'global.inactive'|trans() }}
                            </button>
                        </form>
                    </td>
                    <td>{{ config.type }}</td>
                        {% if is_granted('ROLE_SUPER_ADMIN') %}
                            <td>{{ config.code }}</td>
                        {% endif %}
                    <td>{{ config.summary }}</td>
                    <td>
                        {% if 'color' in config.code  %}
                            <span class="mt-0 mr-1" style="width:20px;height:10px;border:1px solid ;background-color:{{ config.value }}" >&nbsp; &nbsp; &nbsp; </span>
                        {% endif %}
                        {{ config.value }}{{ 'width' in config.code  ? '/12' : '' }}
                    </td>
                    <td>{{ config.position }}</td>
                    <td>
                        {% if vich_uploader_asset(config, 'imageFile') is not null %}
                            <img style="max-height: 100px;" src="{{ asset(vich_uploader_asset(config, 'imageFile')) }}" /></td>
                        {% endif %}
                    <td class="col-sm-2">
                        <a class="btn btn-success" href="{{ path('config_edit', {'id': config.id}) }}">{{'form.label.update'|trans()|raw }}</a>
                    </td>
                    {% if is_granted('ROLE_SUPER_ADMIN') %}
                    <td>
                        {{ include('admin/config/_delete_form.html.twig') }}
                    </td>
                    {% endif %}
                </tr>
        {% else %}
            <tr class="align-middle">
                <td colspan="5">{{ 'global.no_record'|trans()|raw }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {% if is_granted('ROLE_SUPER_ADMIN') %}
        <a class="btn btn-success mb-3" href="{{ path('config_new') }}">{{ 'form.label.create'|trans() }}</a>
    {% endif %}

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.toggle-active-form').forEach(function(form) {
                form.addEventListener('submit', function(e) {
                    e.preventDefault();

                    const formData = new FormData(this);
                    const button = this.querySelector('.toggle-active-btn');
                    const originalText = button.innerHTML;
                    const configId = this.dataset.configId;

                    // Disable button and show loading
                    button.disabled = true;
                    button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> ' + button.dataset.loadingText;

                    fetch(this.action, {
                        method: 'POST',
                        body: formData
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            // Update button appearance
                            button.className = 'btn btn-sm ' + (data.active ? 'btn-success' : 'btn-secondary');
                            button.innerHTML = '<i class="fas ' + (data.active ? 'fa-check' : 'fa-times') + '"></i> ' + (data.active ? '{{ 'global.active'|trans()|escape('js') }}' : '{{ 'global.inactive'|trans()|escape('js') }}');

                            // Show success message
                            const alertDiv = document.createElement('div');
                            alertDiv.className = 'alert alert-success alert-dismissible fade show position-fixed';
                            alertDiv.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
                            alertDiv.innerHTML = `
                                <strong>{{ 'global.success'|trans()|escape('js') }}!</strong> {{ 'config.toggle_success'|trans()|escape('js') }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            `;
                            document.body.appendChild(alertDiv);

                            // Auto-remove alert after 3 seconds
                            setTimeout(() => {
                                if (alertDiv.parentNode) {
                                    alertDiv.remove();
                                }
                            }, 3000);
                        } else {
                            throw new Error(data.error || 'Unknown error');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        // Show error message
                        const alertDiv = document.createElement('div');
                        alertDiv.className = 'alert alert-danger alert-dismissible fade show position-fixed';
                        alertDiv.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
                        alertDiv.innerHTML = `
                            <strong>{{ 'global.error'|trans()|escape('js') }}!</strong> {{ 'config.toggle_error'|trans()|escape('js') }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        `;
                        document.body.appendChild(alertDiv);

                        // Auto-remove alert after 5 seconds
                        setTimeout(() => {
                            if (alertDiv.parentNode) {
                                alertDiv.remove();
                            }
                        }, 5000);
                    })
                    .finally(() => {
                        // Re-enable button
                        button.disabled = false;
                    });
                });
            });
        });
    </script>
{% endblock %}
