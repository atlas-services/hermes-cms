{% extends '/admin/base.html.twig' %}

{% block title %}{{ 'global.edit'|trans }} — {{ user.email }}{% endblock %}

{% block content %}
    {% include 'admin/_newsletter_admin_nav.html.twig' with { context: 'heading' } only %}
    <p class="text-muted mb-4">{{ 'global.edit'|trans }} — {{ user.email }}</p>

    {{ form_start(form, { attr: { class: 'card border-0 shadow-sm p-4' } }) }}
        {{ form_row(form.firstname) }}
        {{ form_row(form.lastname) }}
        {{ form_row(form.email) }}
        {{ form_row(form.activeNewsletter) }}
        {{ form_row(form.plainPassword) }}
        <div class="mt-3">
            <button type="submit" class="btn btn-success">{{ 'form.label.save'|trans|default('global.save'|trans) }}</button>
            <a class="btn btn-outline-secondary" href="{{ path('user_newsletter', { _locale: app.request.locale }) }}">
                {{ 'global.back_to_list'|trans }}
            </a>
        </div>
    {{ form_end(form) }}
{% endblock %}
