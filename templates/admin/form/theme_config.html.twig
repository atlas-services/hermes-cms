{% use 'bootstrap_5_layout.html.twig' %}

{% block form_label -%}
    {%- set label_attr = label_attr|merge({ class: (label_attr.class|default('') ~ ' form-label fw-semibold')|trim }) -%}
    {{- parent() -}}
{%- endblock form_label %}

{# form_widget_simple : géré par bootstrap_5_layout (form-control, form-control-color) #}

{% block choice_widget_collapsed -%}
    {%- set attr = attr|merge({ class: (attr.class|default('') ~ ' form-select')|trim }) -%}
    {{- parent() -}}
{%- endblock choice_widget_collapsed %}

{% block checkbox_row -%}
    <div class="form-check form-switch mb-3">
        {{- form_widget(form, { attr: { class: 'form-check-input' } }) -}}
        {{- form_label(form, null, { label_attr: { class: 'form-check-label' } }) -}}
        {{- form_errors(form) -}}
    </div>
{%- endblock checkbox_row %}

{% block checkbox_widget -%}
    <input type="checkbox" {{ block('widget_attributes') }}{% if value is defined %} value="{{ value }}"{% endif %}{% if checked %} checked="checked"{% endif %} />
{%- endblock checkbox_widget %}
