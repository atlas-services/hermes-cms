# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share

# Identifiant d’instance (ex. jazzenville) : même nom que la base sans extension
# (data/{APP_NAME}.sqlite, data/config/{APP_NAME}.sqlite), uploads, chemins médias.
APP_NAME="app"
APP_BASE_MEDIA_DATA="uploads/${APP_NAME}"
APP_DB="${APP_NAME}.sqlite"
APP_MAX_DEPTH=3
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
# DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
DATABASE_URL="sqlite:///%kernel.project_dir%/data/db/${APP_DB}"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# En local : surcharger dans .env.local (ex. smtp). Si l’identifiant est une adresse e-mail,
# encoder le @ en %40 et les caractères spéciaux du mot de passe (ex. ! → %21) :
# MAILER_DSN="smtp://user%40domain.tld:secret%21@mail.host:587"
MAILER_DSN=null://null
###< symfony/mailer ###

ADMIN_EMAIL=contact@les-ateliers-du-web.fr
ADMIN_PASSWORD=testadmin
# Alias utilisés par config/services.yaml (mailer, commandes, mot de passe oublié)
APP_HERMES_ADMIN_EMAIL="${ADMIN_EMAIL}"
APP_HERMES_ADMIN_PASSWORD="${ADMIN_PASSWORD}"
APP_HERMES_NEWSLETTER_EMAIL="${ADMIN_EMAIL}"

###> vich/uploader-bundle ###
APP_PATH_CONTENT_IMAGES=${APP_BASE_MEDIA_DATA}/entity
###> vich/uploader-bundle ###

###> admin media (Uppy) / vich ###
APP_PATH_CONTENT_IMAGES_POSTS=${APP_BASE_MEDIA_DATA}/content
APP_UPLOAD_MAX_SIZE=10M
###< admin media (Uppy) / vich ###

APP_LIST_TYPE_IMAGE='favicon,bg_image,logo,accueil'

###> API Hermes (catalogue modèles libre — admin) ###
# ReDoc : https://api.hermes-cms.org/api/docs?ui=re_doc
# Comme release/2.2.7 : catalogue = API_HERMES_TEMPLATES + API_HERMES_CATALOG_ENTITY (défaut templates = api-hermes ; libre_templates si ton API l’expose).
API_HERMES_BASE_URL=https://api.hermes-cms.org
API_HERMES_TEMPLATES="${API_HERMES_BASE_URL}/api/"
API_HERMES_CATALOG_ENTITY=templates
# Optionnel : URL complète ou chemin relatif pour remplacer API_HERMES_TEMPLATES + entité catalogue.
API_HERMES_LIBRE_CATALOG_PATH=
API_HERMES_EMAIL=api@hermes-cms.org
API_HERMES_PASSWORD=mdpapicms
API_HERMES_IS_CMS=true
API_HERMES_NOT_JWT_VERSION=false
###< API Hermes ###
